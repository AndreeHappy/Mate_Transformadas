---
const cinLabel = String.raw`Canales Entrada (Cin):`;
const coutLabel = String.raw`Canales Salida (Cout):`;
const kernelLabel = String.raw`Tamaño del Kernel Convolucional (K × K):`;
---

<section id="calculadora" class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200">
    <!-- Encabezado Directo -->
    <div class="mb-6">
      <div class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-2">
        Hardware y Memoria VRAM
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Simulador de Memoria GPU (VRAM)
      </h2>
      <p class="text-sm text-slate-600 mt-1 max-w-3xl">
        ¿Puede tu tarjeta gráfica procesar estas imágenes espaciales en una red neuronal o colapsará tu PC?
      </p>
    </div>

    <!-- Guía Rápida: Para qué sirve y cómo se refleja en tu PC -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8 text-xs">
      <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-1">
        <span class="font-bold text-slate-900 block">1. ¿Para qué sirve?</span>
        <p class="text-slate-600 leading-relaxed">
          Para calcular cuántos gigabytes (GB) de memoria de video ocupará una imagen astronómica al pasar por una capa convolucional.
        </p>
      </div>
      <div class="p-3.5 bg-rose-50 rounded-xl border border-rose-200 space-y-1">
        <span class="font-bold text-rose-900 block">2. ¿Cómo se ve en tu PC?</span>
        <p class="text-rose-800 leading-relaxed font-mono">
          Si abres Stephan's Quintet en PyTorch, tu PC crashea al instante con el error: <strong>CUDA out of memory</strong> (requiere 39.3 GB y tu tarjeta tiene 8 a 16 GB).
        </p>
      </div>
      <div class="p-3.5 bg-emerald-50 rounded-xl border border-emerald-200 space-y-1">
        <span class="font-bold text-emerald-900 block">3. ¿Cómo lo arregla Wavelet?</span>
        <p class="text-emerald-800 leading-relaxed">
          Reduce el tamaño a la mitad en cada eje (submuestreo diádico), bajando la memoria un 75% a solo <strong>9.8 GB</strong>. ¡Ahora sí cabe en tu GPU!
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Controles de Simulación -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <label class="block text-xs font-mono font-semibold text-slate-700 mb-2">
            Selecciona la Resolución de la Imagen:
          </label>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            <button data-res-w="512" data-res-h="512" class="res-preset-btn py-2 px-3 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition">
              512 × 512 (0.26 MP)
            </button>
            <button data-res-w="1024" data-res-h="1024" class="res-preset-btn py-2 px-3 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition">
              1K HD (1.05 MP)
            </button>
            <button data-res-w="4096" data-res-h="4096" class="res-preset-btn py-2 px-3 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition">
              4K Ultra (16.8 MP)
            </button>
            <button data-res-w="4685" data-res-h="4312" class="res-preset-btn py-2 px-3 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition">
              Cartwheel (20.2 MP)
            </button>
            <button data-res-w="11264" data-res-h="3904" class="res-preset-btn py-2 px-3 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 hover:text-slate-900 transition">
              Carina Cliffs (44.0 MP)
            </button>
            <button data-res-w="12654" data-res-h="12132" class="res-preset-btn active py-2 px-3 text-xs rounded-xl bg-blue-50 border border-blue-600 text-blue-700 font-bold transition">
              Stephan (153.5 MP)
            </button>
          </div>
        </div>

        <div>
          <div class="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-2">
            <span>{kernelLabel}</span>
            <span id="kernel-size-val" class="text-blue-600 font-bold">15 × 15</span>
          </div>
          <div class="grid grid-cols-4 gap-2">
            <button data-k="3" class="kernel-btn py-2 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">
              3 × 3 (Local)
            </button>
            <button data-k="7" class="kernel-btn py-2 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">
              7 × 7 (Medio)
            </button>
            <button data-k="15" class="kernel-btn active py-2 text-xs rounded-xl bg-blue-50 border border-blue-600 text-blue-700 font-bold">
              15 × 15 (Contexto)
            </button>
            <button data-k="31" class="kernel-btn py-2 text-xs rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">
              31 × 31 (Galáctico)
            </button>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">{cinLabel}</label>
            <input type="number" id="cin-input" value="32" min="1" max="512" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs font-mono text-slate-900 focus:bg-white focus:outline-none focus:border-blue-500" />
          </div>
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">{coutLabel}</label>
            <input type="number" id="cout-input" value="64" min="1" max="1024" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs font-mono text-slate-900 focus:bg-white focus:outline-none focus:border-blue-500" />
          </div>
        </div>
      </div>

      <!-- Tarjeta de Resultados Métricos y Alerta OOM -->
      <div class="lg:col-span-6 space-y-4">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-5">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200">
            <span class="text-xs font-mono font-bold text-slate-600 uppercase">Estado en GPU</span>
            <span id="gpu-status-badge" class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-rose-100 text-rose-800 border border-rose-200">
              DESBORDAMIENTO VRAM (OOM)
            </span>
          </div>

          <!-- Medidor de VRAM -->
          <div>
            <div class="flex justify-between items-baseline mb-1">
              <span class="text-xs font-mono text-slate-700 font-medium">Memoria Requerida (FP32):</span>
              <span id="vram-val" class="text-xl sm:text-2xl font-mono font-bold text-rose-600">39.30 GB</span>
            </div>
            <div class="w-full bg-slate-200 h-3 rounded-full overflow-hidden border border-slate-300 p-0.5">
              <div id="vram-bar" class="h-full bg-rose-500 rounded-full transition-all duration-300" style="width: 98%;"></div>
            </div>
            <div class="flex justify-between text-[10px] font-mono text-slate-500 mt-1">
              <span>0 GB</span>
              <span>16 GB (RTX 4080)</span>
              <span>24 GB (RTX 4090)</span>
              <span class="text-rose-600 font-semibold">40 GB (A100)</span>
            </div>
          </div>

          <!-- Comparativa de Ahorro Wavelet -->
          <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 space-y-1.5">
            <div class="text-xs font-mono font-bold text-emerald-900 flex items-center justify-between">
              <span>Con Front-End Wavelet 2D (Ahorro del 75%):</span>
              <span id="vram-wavelet-val" class="text-emerald-700 text-sm font-extrabold">9.82 GB</span>
            </div>
            <p class="text-xs text-emerald-800 leading-relaxed font-sans">
              La wavelet divide la imagen a la mitad en cada eje (1/4 del área). La memoria baja de 39.30 GB a solo <strong>9.82 GB</strong>, haciendo que quepa en cualquier GPU común.
            </p>
          </div>

          <!-- Operaciones FLOPs -->
          <div class="grid grid-cols-2 gap-3 pt-2 text-xs font-mono">
            <div class="p-3 bg-white rounded-xl border border-slate-200">
              <span class="text-slate-500 block text-[10px]">Cálculo Espacial Directo:</span>
              <span id="flops-val" class="text-sm font-bold text-slate-900">141.4 TFLOPs</span>
            </div>
            <div class="p-3 bg-white rounded-xl border border-slate-200">
              <span class="text-slate-500 block text-[10px]">Aceleración con FFT 2D:</span>
              <span id="fft-time-val" class="text-sm font-bold text-blue-600">3.8 TFLOPs (37x más veloz)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let currentW = 12654;
  let currentH = 12132;
  let currentK = 15;
  let currentCin = 32;
  let currentCout = 64;

  const vramVal = document.getElementById('vram-val');
  const vramBar = document.getElementById('vram-bar');
  const vramWaveletVal = document.getElementById('vram-wavelet-val');
  const flopsVal = document.getElementById('flops-val');
  const fftTimeVal = document.getElementById('fft-time-val');
  const gpuStatusBadge = document.getElementById('gpu-status-badge');
  const kernelSizeVal = document.getElementById('kernel-size-val');

  function calculateHardwareImpact() {
    const N = currentW * currentH;
    
    // Memoria en FP32 (4 bytes) para el tensor de salida
    const bytesOutput = N * currentCout * 4;
    const gbOutput = bytesOutput / (1024 * 1024 * 1024);
    const gbWavelet = gbOutput * 0.25;

    // FLOPs para convolución espacial directa: 2 * N * Cin * Cout * K^2
    const totalFlops = 2 * N * currentCin * currentCout * (currentK * currentK);
    const tflops = totalFlops / 1e12;

    // FLOPs equivalentes con FFT 2D: O(N * log2(N))
    const fftFlops = 2 * N * Math.log2(N) * (currentCin + currentCout) * 5;
    const tflopsFFT = fftFlops / 1e12;
    const speedup = Math.max(1, (tflops / Math.max(0.1, tflopsFFT))).toFixed(0);

    vramVal.innerText = `${gbOutput.toFixed(2)} GB`;
    vramWaveletVal.innerText = `${gbWavelet.toFixed(2)} GB`;

    // Barra de porcentaje (base 40 GB A100)
    const pct = Math.min(100, (gbOutput / 40) * 100);
    vramBar.style.width = `${pct}%`;

    if (gbOutput > 40) {
      vramBar.className = 'h-full bg-rose-500 rounded-full transition-all duration-300';
      vramVal.className = 'text-xl sm:text-2xl font-mono font-bold text-rose-600';
      gpuStatusBadge.className = 'px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-rose-100 text-rose-800 border border-rose-200';
      gpuStatusBadge.innerText = 'DESBORDAMIENTO VRAM (CUDA OOM)';
    } else if (gbOutput > 24) {
      vramBar.className = 'h-full bg-amber-500 rounded-full transition-all duration-300';
      vramVal.className = 'text-xl sm:text-2xl font-mono font-bold text-amber-700';
      gpuStatusBadge.className = 'px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-amber-100 text-amber-800 border border-amber-200';
      gpuStatusBadge.innerText = 'REQUIERE A100 (40 GB)';
    } else {
      vramBar.className = 'h-full bg-emerald-500 rounded-full transition-all duration-300';
      vramVal.className = 'text-xl sm:text-2xl font-mono font-bold text-emerald-700';
      gpuStatusBadge.className = 'px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-200';
      gpuStatusBadge.innerText = 'MEMORIA DENTRO DEL RANGO';
    }

    flopsVal.innerText = tflops >= 1000 ? `${(tflops / 1000).toFixed(2)} PFLOPs` : `${tflops.toFixed(1)} TFLOPs`;
    fftTimeVal.innerText = `${tflopsFFT.toFixed(1)} TFLOPs (${speedup}x más veloz)`;
  }

  // Event Listeners: Resoluciones
  document.querySelectorAll('.res-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.res-preset-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-bold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-bold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      currentW = parseInt(btn.getAttribute('data-res-w'));
      currentH = parseInt(btn.getAttribute('data-res-h'));
      calculateHardwareImpact();
    });
  });

  // Event Listeners: Kernels
  document.querySelectorAll('.kernel-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.kernel-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-bold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-bold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      currentK = parseInt(btn.getAttribute('data-k'));
      kernelSizeVal.innerText = `${currentK} × ${currentK}`;
      calculateHardwareImpact();
    });
  });

  document.getElementById('cin-input').addEventListener('input', (e) => {
    currentCin = parseInt(e.target.value) || 32;
    calculateHardwareImpact();
  });

  document.getElementById('cout-input').addEventListener('input', (e) => {
    currentCout = parseInt(e.target.value) || 64;
    calculateHardwareImpact();
  });

  calculateHardwareImpact();
</script>
