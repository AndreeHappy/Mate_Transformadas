---
---

<section id="laboratorio" class="py-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Barra de Control Superior Limpia (Sin ruido, sin paleta, sin botón de cargar) -->
  <div class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-2 overflow-x-auto">
      <span class="text-xs font-mono font-bold text-slate-500 uppercase tracking-wider mr-1">Imagen JWST:</span>
      <button 
        data-preset="stephan"
        class="preset-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <span>Stephan Quintet</span>
      </button>
      <button 
        data-preset="cliffs"
        class="preset-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <span>Cosmic Cliffs</span>
      </button>
      <button 
        data-preset="cartwheel"
        class="preset-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <span>Cartwheel Galaxy</span>
      </button>
    </div>

    <!-- Indicador de telescopio -->
    <div class="text-[11px] font-mono text-slate-500 hidden md:block">
      Datos Infrarrojos: NASA / ESA / CSA (James Webb Space Telescope)
    </div>
  </div>

  <!-- Pestañas de Transformadas Principales -->
  <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
    <div class="flex flex-wrap gap-2">
      <button data-mode="sobel" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        1. Sobel Espacial
      </button>
      <button data-mode="fft" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        2. Fourier 2D (FFT)
      </button>
      <button data-mode="ift" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        3. IFT y Gibbs
      </button>
      <button data-mode="wavelet" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        4. Wavelet 2D (Cuadrantes)
      </button>
      <button data-mode="stars" class="mode-tab active px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-blue-600 bg-blue-600 text-white">
        5. Estrellas Aisladas (Wavelet)
      </button>
    </div>

    <!-- Botón Vista 6 Paneles -->
    <button id="toggle-six-panel-btn" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-indigo-50 border border-indigo-200 text-indigo-700 hover:bg-indigo-100 flex items-center gap-1.5 active:scale-95">
      <span>Ver Comparativa de 6 Paneles</span>
    </button>
  </div>

  <!-- Vista Principal Dual (Controles + Canvas Grande) -->
  <div id="dual-view-container" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Panel Izquierdo: Controles Específicos y Diagnóstico Rápido -->
    <div class="lg:col-span-4 flex flex-col gap-4">
      <div class="bg-white rounded-xl p-5 border border-slate-200 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-100">
          <span class="text-xs font-mono font-bold text-slate-800 uppercase tracking-wider">Ajustes</span>
          <span id="timing-badge" class="text-[10px] font-mono font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">
            0.0 ms
          </span>
        </div>

        <!-- 1. Controles Sobel -->
        <div id="controls-sobel" class="space-y-4 hidden">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Componente del Gradiente:</label>
            <div class="grid grid-cols-3 gap-1.5 text-xs">
              <button data-sobel-mode="magnitude" class="sobel-dir-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-semibold">|∇I|</button>
              <button data-sobel-mode="gx" class="sobel-dir-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">Gx (Horiz)</button>
              <button data-sobel-mode="gy" class="sobel-dir-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">Gy (Vert)</button>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-1">
              <span>Umbral de Corte:</span>
              <span id="sobel-threshold-val" class="text-blue-600 font-bold">0</span>
            </div>
            <input type="range" id="sobel-threshold" min="0" max="200" value="0" class="w-full accent-blue-600 cursor-pointer" />
          </div>
        </div>

        <!-- 2. Controles FFT -->
        <div id="controls-fft" class="space-y-3 hidden text-xs text-slate-600 leading-relaxed">
          <p>
            Muestra el espectro de potencias centrado. El núcleo blanco central concentra el brillo medio (DC) y las líneas ortogonales corresponden a bordes y transiciones rápidas.
          </p>
        </div>

        <!-- 3. Controles IFT & Gibbs -->
        <div id="controls-ift" class="space-y-4 hidden">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Filtro en Frecuencia:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-filter-type="highpass" class="filter-type-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-semibold">Pasa-Altos</button>
              <button data-filter-type="lowpass" class="filter-type-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">Pasa-Bajos</button>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-1">
              <span>Radio de Corte (D0):</span>
              <span id="ift-cutoff-val" class="text-blue-600 font-mono font-bold">25 px</span>
            </div>
            <input type="range" id="ift-cutoff" min="5" max="100" value="25" class="w-full accent-blue-600 cursor-pointer" />
          </div>
          <p class="text-[11px] text-amber-900 bg-amber-50 p-2.5 rounded-lg border border-amber-200 leading-relaxed">
            <strong>Anillos de Gibbs:</strong> Observa las ondas circulares falsas alrededor de las estrellas al recortar frecuencias con una compuerta ideal.
          </p>
        </div>

        <!-- 4. Controles Wavelet Cuadrantes -->
        <div id="controls-wavelet" class="space-y-4 hidden">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Base Wavelet Madre:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-wavelet-mother="haar" class="wavelet-mother-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-mono font-semibold">Haar (db1)</button>
              <button data-wavelet-mother="db4" class="wavelet-mother-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 font-mono hover:bg-slate-100">Daubechies 4 (db4)</button>
            </div>
          </div>
          <!-- Explicación pedagógica de la wavelet activa -->
          <div id="wavelet-theory-box" class="text-[11px] font-mono p-3 rounded-lg border bg-slate-50 border-slate-200 leading-relaxed text-slate-700 space-y-1.5">
            <div class="font-bold text-slate-900 flex items-center justify-between">
              <span id="wavelet-theory-title">Haar (db1): Escalón Cuadrado</span>
              <span id="wavelet-theory-badge" class="text-[9px] px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 font-bold">2 Coeficientes</span>
            </div>
            <p id="wavelet-theory-desc">
              Función discontinua a trozos [+1, -1]. Soporte mínimo que calcula diferencias finitas. Es óptima para fuentes puntuales (estrellas) pero genera bordes en bloque en el gas suave.
            </p>
          </div>
          <p class="text-xs text-slate-600">
            La imagen se descompone en <strong>4 cuadrantes independientes</strong>: <strong>LL</strong> (gas cósmico), <strong>LH</strong> (filamentos H), <strong>HL</strong> (filamentos V) y <strong>HH</strong> (estrellas y diagonales).
          </p>
        </div>

        <!-- 5. Controles Aislamiento Estelar -->
        <div id="controls-stars" class="space-y-4">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Base Wavelet Madre:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-wavelet-mother="haar" class="wavelet-mother-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-mono font-semibold">Haar (db1)</button>
              <button data-wavelet-mother="db4" class="wavelet-mother-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 font-mono hover:bg-slate-100">Daubechies 4 (db4)</button>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-1">
              <span>Umbral de Extracción Estelar:</span>
              <span id="star-percentile-val" class="text-amber-700 font-mono font-bold">98.5%</span>
            </div>
            <input type="range" id="star-percentile" min="90" max="99.9" step="0.1" value="98.5" class="w-full accent-amber-600 cursor-pointer" />
          </div>

          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Método de Umbral:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-shrinkage="hard" class="shrinkage-btn active py-1.5 rounded-lg bg-amber-50 border border-amber-600 text-amber-800 font-mono font-semibold">Hard (Corte Directo)</button>
              <button data-shrinkage="soft" class="shrinkage-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 font-mono hover:bg-slate-100">Soft (Donoho)</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Diagnóstico Breve -->
      <div class="bg-white rounded-xl p-4 border border-slate-200">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-mono uppercase text-slate-500 font-bold">Diagnóstico:</span>
          <span id="quick-badge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
            Aislamiento Óptimo
          </span>
        </div>
        <p id="quick-desc" class="text-xs text-slate-600 leading-relaxed">
          El gas suave se anula a cero en HH, aislando únicamente las estrellas puntuales limpias.
        </p>
      </div>
    </div>

    <!-- Panel Derecho: Vistas de Canvas -->
    <div class="lg:col-span-8 flex flex-col gap-4">
      <!-- 1. Vista Dual Estándar (Entrada + Salida) para Sobel, FFT, IFT y Estrellas -->
      <div id="standard-dual-view" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Canvas 1: Entrada -->
        <div class="bg-white rounded-xl p-4 border border-slate-200 flex flex-col items-center">
          <div class="w-full flex items-center justify-between mb-2.5 px-1">
            <span class="text-xs font-mono font-bold text-slate-800">1. ENTRADA (Original)</span>
            <div class="flex items-center gap-1.5">
              <span id="canvas-orig-dim" class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">512 × 512</span>
              <button id="zoom-orig-btn" title="Ampliar e inspeccionar" class="text-[10px] font-mono text-slate-600 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded transition flex items-center gap-1">
                <span>Lupa / Matriz</span>
              </button>
            </div>
          </div>
          <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 flex items-center justify-center group cursor-zoom-in">
            <canvas id="canvas-original" width="512" height="512" class="w-full h-full object-contain block"></canvas>
            <div class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] font-mono px-2 py-0.5 rounded pointer-events-none opacity-0 group-hover:opacity-100 transition">
              Clic para lupa de píxeles
            </div>
          </div>
          <div class="w-full mt-2 text-[10px] font-mono text-slate-600 bg-slate-50 px-2 py-1 rounded border border-slate-200 text-center" id="pixel-inspector">
            Pasa el cursor sobre la imagen para inspeccionar píxeles
          </div>
        </div>

        <!-- Canvas 2: Salida Transformada -->
        <div class="bg-white rounded-xl p-4 border border-slate-200 flex flex-col items-center">
          <div class="w-full flex items-center justify-between mb-2.5 px-1">
            <span id="canvas-trans-title" class="text-xs font-mono font-bold text-blue-700">2. SALIDA TRANSFORMADA</span>
            <div class="flex items-center gap-2">
              <button id="zoom-trans-btn" title="Ampliar e inspeccionar" class="text-[10px] font-mono text-blue-700 hover:text-blue-900 bg-blue-50 hover:bg-blue-100 border border-blue-200 px-1.5 py-0.5 rounded transition flex items-center gap-1">
                <span>Lupa / Matriz</span>
              </button>
              <button id="download-btn" class="text-[11px] font-mono font-semibold text-blue-600 hover:text-blue-800 transition">Descargar PNG</button>
            </div>
          </div>
          <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 flex items-center justify-center group cursor-zoom-in">
            <canvas id="canvas-transformed" width="512" height="512" class="w-full h-full object-contain block"></canvas>
            <div class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] font-mono px-2 py-0.5 rounded pointer-events-none opacity-0 group-hover:opacity-100 transition">
              Clic para lupa de píxeles
            </div>
          </div>
          <div class="w-full mt-2 text-[10px] font-mono text-slate-600 bg-slate-50 px-2 py-1 rounded border border-slate-200 text-center" id="canvas-trans-sub">
            Wavelet: Haar • Estrellas Aisladas
          </div>
        </div>
      </div>

      <!-- 2. Vista Dedicada: 4 Cuadrantes Wavelet 2D Separados -->
      <div id="wavelet-quads-view" class="bg-white rounded-xl p-4 border border-slate-200 hidden flex flex-col gap-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-200">
          <div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-900 font-mono uppercase tracking-wider flex items-center gap-2">
              <span>Wavelet 2D: 4 Cuadrantes Separados de Mallat</span>
              <span id="quad-mother-badge" class="text-[10px] font-mono font-bold bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded">
                Base: HAAR
              </span>
            </h3>
            <p class="text-xs text-slate-500 font-mono mt-0.5">
              Cada sub-banda se procesa de forma independiente (256 × 256 px). Haz clic en cualquier cuadrante para abrir la Lupa.
            </p>
          </div>
          <div class="text-[11px] font-mono text-slate-500 bg-slate-50 px-2.5 py-1 rounded border border-slate-200 whitespace-nowrap self-start sm:self-auto">
            Submuestreo: ↓2 (Ahorro 75% VRAM)
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Cuadrante LL -->
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex flex-col items-center group">
            <div class="w-full flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-slate-800">1. LL (Aproximación - Gas Suave)</span>
              <button data-quad-zoom="ll" class="text-[10px] font-mono text-slate-600 bg-white hover:bg-slate-100 border border-slate-200 px-2 py-0.5 rounded transition">
                Ampliar Lupa
              </button>
            </div>
            <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 cursor-zoom-in group">
              <canvas id="canvas-dwt-ll" width="256" height="256" class="w-full h-full object-contain block"></canvas>
              <div class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] font-mono px-2 py-0.5 rounded pointer-events-none opacity-0 group-hover:opacity-100 transition">
                Clic para lupa
              </div>
            </div>
            <div class="w-full mt-2 text-[10px] font-mono text-slate-600 bg-white px-2 py-1 rounded border border-slate-200 text-center">
              Filtro: h_low * h_low • Preserva brillo cósmico
            </div>
          </div>

          <!-- Cuadrante LH -->
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex flex-col items-center group">
            <div class="w-full flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-indigo-700">2. LH (Detalles Horizontales)</span>
              <button data-quad-zoom="lh" class="text-[10px] font-mono text-indigo-700 bg-white hover:bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded transition">
                Ampliar Lupa
              </button>
            </div>
            <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 cursor-zoom-in group">
              <canvas id="canvas-dwt-lh" width="256" height="256" class="w-full h-full object-contain block"></canvas>
              <div class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] font-mono px-2 py-0.5 rounded pointer-events-none opacity-0 group-hover:opacity-100 transition">
                Clic para lupa
              </div>
            </div>
            <div class="w-full mt-2 text-[10px] font-mono text-slate-600 bg-white px-2 py-1 rounded border border-slate-200 text-center">
              Filtro: h_high * h_low • Filamentos horizontales
            </div>
          </div>

          <!-- Cuadrante HL -->
          <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex flex-col items-center group">
            <div class="w-full flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-purple-700">3. HL (Detalles Verticales)</span>
              <button data-quad-zoom="hl" class="text-[10px] font-mono text-purple-700 bg-white hover:bg-purple-50 border border-purple-200 px-2 py-0.5 rounded transition">
                Ampliar Lupa
              </button>
            </div>
            <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 cursor-zoom-in group">
              <canvas id="canvas-dwt-hl" width="256" height="256" class="w-full h-full object-contain block"></canvas>
              <div class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] font-mono px-2 py-0.5 rounded pointer-events-none opacity-0 group-hover:opacity-100 transition">
                Clic para lupa
              </div>
            </div>
            <div class="w-full mt-2 text-[10px] font-mono text-slate-600 bg-white px-2 py-1 rounded border border-slate-200 text-center">
              Filtro: h_low * h_high • Filamentos verticales
            </div>
          </div>

          <!-- Cuadrante HH -->
          <div class="bg-amber-50/50 p-3 rounded-xl border border-amber-300 flex flex-col items-center group">
            <div class="w-full flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-amber-800">4. HH (Diagonales y Estrellas)</span>
              <button data-quad-zoom="hh" class="text-[10px] font-mono text-amber-800 bg-white hover:bg-amber-50 border border-amber-300 px-2 py-0.5 rounded transition font-bold">
                Ampliar Lupa
              </button>
            </div>
            <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-amber-400 cursor-zoom-in group">
              <canvas id="canvas-dwt-hh" width="256" height="256" class="w-full h-full object-contain block"></canvas>
              <div class="absolute bottom-2 right-2 bg-slate-900/80 text-white text-[10px] font-mono px-2 py-0.5 rounded pointer-events-none opacity-0 group-hover:opacity-100 transition">
                Clic para lupa
              </div>
            </div>
            <div class="w-full mt-2 text-[10px] font-mono text-amber-900 bg-white px-2 py-1 rounded border border-amber-200 text-center font-bold">
              Filtro: h_high * h_high • ¡Gas anulado a 0.00!
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Vista Secundaria: Pipeline Completo de 6 Paneles -->
  <div id="six-panel-container" class="mt-8 bg-white rounded-xl p-5 border border-slate-200 hidden">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
      <div>
        <h3 class="text-sm font-bold text-slate-900 font-mono uppercase tracking-wider flex items-center gap-2">
          <span>Pipeline Comparativo Completo (6 Paneles)</span>
          <span class="text-[10px] text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200 font-semibold">
            Notebook Python
          </span>
        </h3>
      </div>
      <button id="close-six-panel-btn" class="text-xs font-mono font-semibold text-slate-600 hover:text-slate-900 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-200 transition">
        ✕ Volver a Vista Dual
      </button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <!-- Panel 1: Original -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-slate-700 block mb-1.5">1. Original I(x, y)</span>
        <canvas id="p6-c1" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 2: Sobel -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-rose-700 block mb-1.5">2. Sobel (Inferno)</span>
        <canvas id="p6-c2" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 3: FFT -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-indigo-700 block mb-1.5">3. 2D-FFT (Magma)</span>
        <canvas id="p6-c3" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 4: IFT Gibbs -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-amber-700 block mb-1.5">4. IFT Gibbs (Inferno)</span>
        <canvas id="p6-c4" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 5: DWT Cuadrantes -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-slate-700 block mb-1.5">5. 2D-DWT [LL, HL; LH, HH]</span>
        <canvas id="p6-c5" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 6: Wavelet Hot -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-amber-300 text-center">
        <span class="text-[11px] font-mono text-amber-800 block mb-1.5 font-bold">6. Wavelet Isolation (Hot)</span>
        <canvas id="p6-c6" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
    </div>
  </div>

  <!-- Modal Lightbox de Comparativa y Zoom en Alta Definición -->
  <div id="zoom-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-6">
    <div class="bg-white rounded-2xl max-w-5xl w-full max-h-[92vh] flex flex-col shadow-2xl border border-slate-200 overflow-hidden">
      <!-- Modal Header -->
      <div class="px-5 py-3.5 border-b border-slate-200 flex items-center justify-between bg-slate-50">
        <div>
          <h3 id="modal-title" class="text-sm sm:text-base font-bold text-slate-900 font-mono flex items-center gap-2">
            <span>Inspección Detallada: Comparativa Radiométrica</span>
            <span id="modal-mode-badge" class="text-[10px] font-mono font-bold bg-blue-100 text-blue-800 px-2 py-0.5 rounded border border-blue-200">
              Wavelet HH
            </span>
          </h3>
          <p class="text-xs text-slate-500 font-mono mt-0.5">
            Pasa el cursor sobre cualquiera de las imágenes para inspeccionar coordenadas y niveles simultáneamente.
          </p>
        </div>
        <button id="close-modal-btn" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition" title="Cerrar (Esc)">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Body (Side by side Canvases + Matriz 7x7) -->
      <div class="p-4 sm:p-5 overflow-y-auto flex-1 flex flex-col gap-4 bg-slate-100">
        <!-- Canvases lado a lado -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Entrada Modal -->
          <div class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col items-center shadow-sm">
            <div class="w-full flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-bold text-slate-800">1. Original I(x, y)</span>
              <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">512 × 512</span>
            </div>
            <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 flex items-center justify-center cursor-crosshair">
              <canvas id="modal-canvas-orig" width="512" height="512" class="w-full h-full object-contain block"></canvas>
            </div>
            <div id="modal-orig-inspector" class="w-full mt-2 text-[11px] font-mono text-slate-700 bg-slate-50 px-2.5 py-1.5 rounded border border-slate-200 text-center font-medium">
              Coord: (—, —) | Brillo Entrada: —
            </div>
          </div>

          <!-- Salida Modal -->
          <div class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col items-center shadow-sm">
            <div class="w-full flex items-center justify-between mb-2">
              <span id="modal-trans-label" class="text-xs font-mono font-bold text-blue-700">2. Salida Transformada</span>
              <span id="modal-trans-dim" class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">512 × 512</span>
            </div>
            <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 flex items-center justify-center cursor-crosshair">
              <canvas id="modal-canvas-trans" width="512" height="512" class="w-full h-full object-contain block"></canvas>
            </div>
            <div id="modal-trans-inspector" class="w-full mt-2 text-[11px] font-mono text-blue-800 bg-blue-50 px-2.5 py-1.5 rounded border border-blue-200 text-center font-medium">
              Coord: (—, —) | Salida Procesada: —
            </div>
          </div>
        </div>

        <!-- Matriz Científica 7x7 de Lupa de Píxeles -->
        <div class="bg-slate-900 text-slate-100 p-4 rounded-xl border border-slate-800 shadow-md">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 pb-2 border-b border-slate-800 mb-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-amber-400">LUPA DE RESOLUCION ATOMICA: MATRIZ DE PIXELES 7×7</span>
              <span id="matrix-center-coord" class="text-[10px] font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-300 border border-slate-700">
                Pixel Central: (x: 256, y: 256)
              </span>
            </div>
            <span class="text-[10px] font-mono text-slate-400">
              Observa como cambian los valores numericos exactos al mover el cursor
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Sub-Matriz Entrada 7x7 -->
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 flex flex-col items-center">
              <span class="text-[11px] font-mono font-bold text-slate-300 mb-2">Entrada I(x, y) - Vecindad 7×7</span>
              <div id="matrix-orig-grid" class="grid grid-cols-7 gap-1 w-full max-w-[320px]">
                <!-- 49 celdas generadas por JS -->
              </div>
            </div>

            <!-- Sub-Matriz Salida 7x7 -->
            <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 flex flex-col items-center">
              <span id="matrix-trans-title" class="text-[11px] font-mono font-bold text-blue-400 mb-2">Salida Transformada - Vecindad 7×7</span>
              <div id="matrix-trans-grid" class="grid grid-cols-7 gap-1 w-full max-w-[320px]">
                <!-- 49 celdas generadas por JS -->
              </div>
            </div>
          </div>
          <div class="mt-2 text-[10px] font-mono text-slate-400 text-center">
            La celda central resaltada con borde cyan/ambar corresponde al pixel exacto bajo el cursor.
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-5 py-3 bg-white border-t border-slate-200 flex items-center justify-between text-xs font-mono text-slate-500">
        <span class="hidden sm:inline">Presiona ESC o haz clic fuera para cerrar</span>
        <button id="modal-close-action" class="px-4 py-1.5 rounded-lg bg-slate-800 text-white font-semibold hover:bg-slate-900 transition">
          Cerrar Inspección
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { applyColormap } from '../scripts/colormaps.js';
  import { 
    applySobel, 
    computeFFT2D, 
    getLogSpectrumImage, 
    applyFrequencyFilterAndIFT, 
    computeDWT2D, 
    getWaveletQuadImage, 
    isolateWaveletStars,
    getIndividualSubbandImage
  } from '../scripts/transforms-advanced.js';

  let currentRawImage = new Image();
  let baseGrayscale = null;
  let activeGrayscale = null;
  let currentMode = 'stars';
  let motherWavelet = 'haar';
  let shrinkageMode = 'hard';

  // Parámetros
  let sobelMode = 'magnitude';
  let sobelThreshold = 0;
  let iftCutoff = 25;
  let iftType = 'highpass';
  let starPercentile = 98.5;

  let cachedFFT = null;
  let cachedDWT = null;

  const canvasOriginal = document.getElementById('canvas-original');
  const canvasTransformed = document.getElementById('canvas-transformed');
  const ctxOriginal = canvasOriginal.getContext('2d');
  const ctxTransformed = canvasTransformed.getContext('2d');

  const standardDualView = document.getElementById('standard-dual-view');
  const waveletQuadsView = document.getElementById('wavelet-quads-view');
  const canvasDwtLL = document.getElementById('canvas-dwt-ll');
  const canvasDwtLH = document.getElementById('canvas-dwt-lh');
  const canvasDwtHL = document.getElementById('canvas-dwt-hl');
  const canvasDwtHH = document.getElementById('canvas-dwt-hh');
  const quadMotherBadge = document.getElementById('quad-mother-badge');

  const waveletTheoryTitle = document.getElementById('wavelet-theory-title');
  const waveletTheoryBadge = document.getElementById('wavelet-theory-badge');
  const waveletTheoryDesc = document.getElementById('wavelet-theory-desc');

  const timingBadge = document.getElementById('timing-badge');
  const canvasTransTitle = document.getElementById('canvas-trans-title');
  const canvasTransSub = document.getElementById('canvas-trans-sub');
  const quickBadge = document.getElementById('quick-badge');
  const quickDesc = document.getElementById('quick-desc');
  const pixelInspector = document.getElementById('pixel-inspector');

  const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
  const presets = {
    stephan: `${baseUrl}images/stephan_quintet.jpg`,
    cliffs: `${baseUrl}images/cosmic_cliffs.jpg`,
    cartwheel: `${baseUrl}images/cartwheel_galaxy.jpg`
  };

  const diagnostics = {
    sobel: {
      badge: 'Falla en Gas',
      color: 'bg-rose-50 text-rose-800 border-rose-200',
      desc: 'Sobel detecta bordes pero el gas suave continuo genera un gradiente 4 veces mayor que las estrellas, ocultándolas.'
    },
    fft: {
      badge: 'Sin Localización Espacial',
      color: 'bg-rose-50 text-rose-800 border-rose-200',
      desc: 'Fourier muestra las frecuencias globales de la imagen pero pierde la posición (x, y) de las estrellas.'
    },
    ift: {
      badge: 'Anillos Falsos de Gibbs',
      color: 'bg-amber-50 text-amber-800 border-amber-200',
      desc: 'El corte de frecuencias produce ondas oscilatorias concéntricas falsas (+8.95%) alrededor de cada estrella.'
    },
    wavelet: {
      badge: 'Éxito Multirresolución',
      color: 'bg-emerald-50 text-emerald-800 border-emerald-200',
      desc: 'Separa la imagen en 4 sub-bandas: LL (gas suave), LH/HL (bordes direccionales) y HH (estrellas y diagonales).'
    },
    stars: {
      badge: 'Aislamiento Estelar Óptimo',
      color: 'bg-emerald-50 text-emerald-800 border-emerald-200',
      desc: 'El gas suave se anula a cero en HH, aislando únicamente las estrellas puntuales limpias.'
    }
  };

  function loadPresetImage(url) {
    currentRawImage = new Image();
    currentRawImage.crossOrigin = 'anonymous';
    currentRawImage.src = url;
    currentRawImage.onload = () => {
      canvasOriginal.width = 512;
      canvasOriginal.height = 512;
      ctxOriginal.drawImage(currentRawImage, 0, 0, 512, 512);

      const imgData = ctxOriginal.getImageData(0, 0, 512, 512);
      const data = imgData.data;
      baseGrayscale = new Uint8ClampedArray(512 * 512);

      for (let i = 0; i < 512 * 512; i++) {
        baseGrayscale[i] = Math.round(0.299 * data[i * 4] + 0.587 * data[i * 4 + 1] + 0.114 * data[i * 4 + 2]);
      }

      activeGrayscale = baseGrayscale;
      cachedFFT = null;
      cachedDWT = null;
      renderCurrentPipeline();
    };
  }

  function renderOutput(uint8Grayscale, width, height, colormap) {
    canvasTransformed.width = width;
    canvasTransformed.height = height;
    const rgba = applyColormap(uint8Grayscale, width, height, colormap);
    const imgData = new ImageData(rgba, width, height);
    ctxTransformed.putImageData(imgData, 0, 0);
  }

  const cachedSubbandImages = {};

  function renderWaveletQuadrants(dwt) {
    if (!dwt) return;
    const { LL, LH, HL, HH, halfW, halfH } = dwt;
    if (quadMotherBadge) quadMotherBadge.innerText = `BASE: ${motherWavelet.toUpperCase()}`;

    function drawSubband(canvas, subband, isDetail, colormap) {
      if (!canvas) return null;
      const ctx = canvas.getContext('2d');
      const uint8 = getIndividualSubbandImage(subband, halfW, halfH, isDetail);
      const rgba = applyColormap(uint8, halfW, halfH, colormap);
      const imgData = new ImageData(rgba, halfW, halfH);
      ctx.putImageData(imgData, 0, 0);
      return { uint8, rgba };
    }

    cachedSubbandImages.ll = drawSubband(canvasDwtLL, LL, false, 'grayscale');
    cachedSubbandImages.lh = drawSubband(canvasDwtLH, LH, true, 'inferno');
    cachedSubbandImages.hl = drawSubband(canvasDwtHL, HL, true, 'inferno');
    cachedSubbandImages.hh = drawSubband(canvasDwtHH, HH, true, 'hot');
  }

  function renderCurrentPipeline() {
    if (!activeGrayscale) return;
    const t0 = performance.now();

    if (currentMode === 'sobel') {
      canvasTransTitle.innerText = `Sobel Espacial (${sobelMode.toUpperCase()})`;
      const result = applySobel(activeGrayscale, 512, 512, {
        mode: sobelMode,
        threshold: sobelThreshold
      });
      renderOutput(result, 512, 512, 'inferno');
      canvasTransSub.innerText = 'Operador Sobel 3x3 • Paleta: INFERNO';
    }
    else if (currentMode === 'fft') {
      canvasTransTitle.innerText = 'Espectro de Potencias Fourier 2D';
      if (!cachedFFT) {
        cachedFFT = computeFFT2D(activeGrayscale, 512);
      }
      const logSpec = getLogSpectrumImage(cachedFFT.shiftReal, cachedFFT.shiftImag, 512);
      renderOutput(logSpec, 512, 512, 'magma');
      canvasTransSub.innerText = 'FFT Cooley-Tukey Centrada • Paleta: MAGMA';
    }
    else if (currentMode === 'ift') {
      canvasTransTitle.innerText = `Reconstrucción IFT (${iftType.toUpperCase()}, D0=${iftCutoff}px)`;
      if (!cachedFFT) {
        cachedFFT = computeFFT2D(activeGrayscale, 512);
      }
      const recon = applyFrequencyFilterAndIFT(cachedFFT.shiftReal, cachedFFT.shiftImag, 512, iftCutoff, iftType);
      renderOutput(recon, 512, 512, 'inferno');
      canvasTransSub.innerText = 'Fenómeno de Gibbs (Sobreimpulso 8.95%) • Paleta: INFERNO';
    }
    else if (currentMode === 'wavelet') {
      canvasTransTitle.innerText = `Wavelet 2D (${motherWavelet.toUpperCase()}) - 4 Cuadrantes Separados`;
      if (!cachedDWT || cachedDWT.mother !== motherWavelet) {
        cachedDWT = computeDWT2D(activeGrayscale, 512, 512, motherWavelet);
      }
      renderWaveletQuadrants(cachedDWT);
      canvasTransSub.innerText = `4 Cuadrantes Independientes • Wavelet: ${motherWavelet.toUpperCase()}`;
    }
    else if (currentMode === 'stars') {
      canvasTransTitle.innerText = `Aislamiento Estelar Óptimo (${motherWavelet.toUpperCase()} - ${starPercentile}%)`;
      if (!cachedDWT || cachedDWT.mother !== motherWavelet) {
        cachedDWT = computeDWT2D(activeGrayscale, 512, 512, motherWavelet);
      }
      const { output, halfW, halfH } = isolateWaveletStars(cachedDWT, starPercentile, shrinkageMode);
      renderOutput(output, halfW, halfH, 'hot');
      canvasTransSub.innerText = 'Sub-banda HH + Umbralizado • Paleta: HOT (Fuego)';
    }

    const t1 = performance.now();
    timingBadge.innerText = `${(t1 - t0).toFixed(1)} ms`;

    const diag = diagnostics[currentMode];
    quickBadge.className = `px-2 py-0.5 rounded text-[10px] font-bold border ${diag.color}`;
    quickBadge.innerText = diag.badge;
    quickDesc.innerText = diag.desc;
  }

  // Renderizar los 6 paneles en paralelo estilo Jupyter Notebook
  function renderSixPanels() {
    if (!activeGrayscale) return;

    function drawTo(canvasId, grayscaleData, width, height, colormap) {
      const c = document.getElementById(canvasId);
      c.width = width;
      c.height = height;
      const ctx = c.getContext('2d');
      const rgba = applyColormap(grayscaleData, width, height, colormap);
      const idata = new ImageData(rgba, width, height);
      ctx.putImageData(idata, 0, 0);
    }

    drawTo('p6-c1', activeGrayscale, 512, 512, 'grayscale');
    const sobelRes = applySobel(activeGrayscale, 512, 512, { mode: 'magnitude', threshold: 0 });
    drawTo('p6-c2', sobelRes, 512, 512, 'inferno');
    if (!cachedFFT) cachedFFT = computeFFT2D(activeGrayscale, 512);
    const spec = getLogSpectrumImage(cachedFFT.shiftReal, cachedFFT.shiftImag, 512);
    drawTo('p6-c3', spec, 512, 512, 'magma');
    const recon = applyFrequencyFilterAndIFT(cachedFFT.shiftReal, cachedFFT.shiftImag, 512, 25, 'highpass');
    drawTo('p6-c4', recon, 512, 512, 'inferno');
    if (!cachedDWT) cachedDWT = computeDWT2D(activeGrayscale, 512, 512, 'haar');
    const quad = getWaveletQuadImage(cachedDWT);
    drawTo('p6-c5', quad, 512, 512, 'grayscale');
    const { output, halfW, halfH } = isolateWaveletStars(cachedDWT, 98.5, 'hard');
    drawTo('p6-c6', output, halfW, halfH, 'hot');
  }

  // Listeners Presets
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-btn').forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'font-bold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'font-bold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      const preset = btn.getAttribute('data-preset');
      loadPresetImage(presets[preset]);
    });
  });

  // Mode Tabs
  document.querySelectorAll('.mode-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.mode-tab').forEach(t => {
        t.classList.remove('border-blue-600', 'bg-blue-600', 'text-white');
        t.classList.add('border-slate-200', 'bg-white', 'text-slate-700');
      });
      tab.classList.add('border-blue-600', 'bg-blue-600', 'text-white');
      tab.classList.remove('border-slate-200', 'bg-white', 'text-slate-700');

      currentMode = tab.getAttribute('data-mode');

      ['sobel', 'fft', 'ift', 'wavelet', 'stars'].forEach(m => {
        const el = document.getElementById(`controls-${m}`);
        if (el) el.classList.add('hidden');
      });
      const active = document.getElementById(`controls-${currentMode}`);
      if (active) active.classList.remove('hidden');

      if (currentMode === 'wavelet') {
        standardDualView?.classList.add('hidden');
        waveletQuadsView?.classList.remove('hidden');
      } else {
        standardDualView?.classList.remove('hidden');
        waveletQuadsView?.classList.add('hidden');
      }

      renderCurrentPipeline();
    });
  });

  function updateWaveletTheory() {
    if (!waveletTheoryTitle) return;
    if (motherWavelet === 'haar') {
      waveletTheoryTitle.innerText = 'Haar (db1): Escalón Cuadrado';
      waveletTheoryBadge.innerText = '2 Coeficientes';
      waveletTheoryBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-blue-100 text-blue-800 font-bold';
      waveletTheoryDesc.innerText = 'Función discontinua a trozos [+1, -1]. Soporte mínimo que calcula diferencias finitas. Es óptima para fuentes puntuales (estrellas) pero genera bordes en bloque en el gas suave.';
    } else {
      waveletTheoryTitle.innerText = 'Daubechies 4 (db4): Onda Suave';
      waveletTheoryBadge.innerText = '4 Coeficientes';
      waveletTheoryBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold';
      waveletTheoryDesc.innerText = 'Ondícula continua y asimétrica de soporte compacto. Posee 2 momentos nulos (anula constantes y rampas lineales). Elimina el efecto de bloques y modela suavemente el gas continuo y filamentos.';
    }
  }

  // Mother Wavelet Toggle
  document.querySelectorAll('.wavelet-mother-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.wavelet-mother-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      motherWavelet = btn.getAttribute('data-wavelet-mother');
      updateWaveletTheory();
      cachedDWT = null;
      renderCurrentPipeline();
    });
  });

  // Shrinkage Mode
  document.querySelectorAll('.shrinkage-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.shrinkage-btn').forEach(b => {
        b.classList.remove('bg-amber-50', 'border-amber-600', 'text-amber-800', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-amber-50', 'border-amber-600', 'text-amber-800', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      shrinkageMode = btn.getAttribute('data-shrinkage');
      renderCurrentPipeline();
    });
  });

  // Sobel Direction
  document.querySelectorAll('.sobel-dir-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sobel-dir-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      sobelMode = btn.getAttribute('data-sobel-mode');
      renderCurrentPipeline();
    });
  });

  document.getElementById('sobel-threshold').addEventListener('input', (e) => {
    sobelThreshold = parseInt(e.target.value);
    document.getElementById('sobel-threshold-val').innerText = sobelThreshold;
    renderCurrentPipeline();
  });

  // IFT Filter Type
  document.querySelectorAll('.filter-type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-type-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      iftType = btn.getAttribute('data-filter-type');
      renderCurrentPipeline();
    });
  });

  document.getElementById('ift-cutoff').addEventListener('input', (e) => {
    iftCutoff = parseInt(e.target.value);
    document.getElementById('ift-cutoff-val').innerText = `${iftCutoff} px`;
    renderCurrentPipeline();
  });

  // Star Percentile
  document.getElementById('star-percentile').addEventListener('input', (e) => {
    starPercentile = parseFloat(e.target.value);
    document.getElementById('star-percentile-val').innerText = `${starPercentile.toFixed(1)}%`;
    renderCurrentPipeline();
  });

  // Pixel Inspector
  canvasOriginal.addEventListener('mousemove', (e) => {
    if (!activeGrayscale) return;
    const rect = canvasOriginal.getBoundingClientRect();
    const x = Math.floor((e.clientX - rect.left) * (512 / rect.width));
    const y = Math.floor((e.clientY - rect.top) * (512 / rect.height));
    if (x >= 0 && x < 512 && y >= 0 && y < 512) {
      const val = activeGrayscale[y * 512 + x];
      pixelInspector.innerText = `Coordenada: (${x}, ${y}) | Brillo: ${val}`;
    }
  });

  // Toggle 6-panel view
  const sixPanelContainer = document.getElementById('six-panel-container');
  const dualViewContainer = document.getElementById('dual-view-container');
  const toggleSixBtn = document.getElementById('toggle-six-panel-btn');
  const closeSixBtn = document.getElementById('close-six-panel-btn');

  toggleSixBtn.addEventListener('click', () => {
    sixPanelContainer.classList.remove('hidden');
    dualViewContainer.classList.add('hidden');
    renderSixPanels();
  });

  closeSixBtn.addEventListener('click', () => {
    sixPanelContainer.classList.add('hidden');
    dualViewContainer.classList.remove('hidden');
  });

  // Download
  document.getElementById('download-btn').addEventListener('click', () => {
    const link = document.createElement('a');
    link.download = `jwst_${currentMode}.png`;
    link.href = canvasTransformed.toDataURL('image/png');
    link.click();
  });

  // Modal Lightbox de Zoom y Comparativa con Lupa Atómica
  const zoomModal = document.getElementById('zoom-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalCloseAction = document.getElementById('modal-close-action');
  const modalCanvasOrig = document.getElementById('modal-canvas-orig');
  const modalCanvasTrans = document.getElementById('modal-canvas-trans');
  const modalCtxOrig = modalCanvasOrig.getContext('2d');
  const modalCtxTrans = modalCanvasTrans.getContext('2d');
  const modalModeBadge = document.getElementById('modal-mode-badge');
  const modalTransLabel = document.getElementById('modal-trans-label');
  const modalTransDim = document.getElementById('modal-trans-dim');
  const modalOrigInspector = document.getElementById('modal-orig-inspector');
  const modalTransInspector = document.getElementById('modal-trans-inspector');

  const matrixOrigGrid = document.getElementById('matrix-orig-grid');
  const matrixTransGrid = document.getElementById('matrix-trans-grid');
  const matrixCenterCoord = document.getElementById('matrix-center-coord');
  const matrixTransTitle = document.getElementById('matrix-trans-title');

  const origMatrixCells = [];
  const transMatrixCells = [];

  function initMatrixGrids() {
    if (!matrixOrigGrid || !matrixTransGrid) return;
    matrixOrigGrid.innerHTML = '';
    matrixTransGrid.innerHTML = '';
    for (let i = 0; i < 49; i++) {
      const c1 = document.createElement('div');
      c1.className = 'w-full aspect-square flex items-center justify-center font-mono font-bold text-[9px] rounded-sm transition-colors border border-slate-800';
      matrixOrigGrid.appendChild(c1);
      origMatrixCells.push(c1);

      const c2 = document.createElement('div');
      c2.className = 'w-full aspect-square flex items-center justify-center font-mono font-bold text-[9px] rounded-sm transition-colors border border-slate-800';
      matrixTransGrid.appendChild(c2);
      transMatrixCells.push(c2);
    }
  }
  initMatrixGrids();

  function openZoomModal(subbandKey = null) {
    if (!activeGrayscale) return;
    zoomModal.classList.remove('hidden');

    modalCanvasOrig.width = canvasOriginal.width;
    modalCanvasOrig.height = canvasOriginal.height;
    modalCtxOrig.drawImage(canvasOriginal, 0, 0);

    if (subbandKey && typeof subbandKey === 'string' && ['ll', 'lh', 'hl', 'hh'].includes(subbandKey)) {
      const titles = {
        ll: 'Cuadrante LL: Aproximación (Gas Cósmico Suave)',
        lh: 'Cuadrante LH: Detalles Horizontales (Filamentos)',
        hl: 'Cuadrante HL: Detalles Verticales (Filamentos)',
        hh: 'Cuadrante HH: Diagonales y Estrellas Aisladas'
      };
      modalModeBadge.innerText = `WAVELET ${subbandKey.toUpperCase()}`;
      modalTransLabel.innerText = titles[subbandKey];
      modalTransDim.innerText = '256 × 256';
      if (matrixTransTitle) matrixTransTitle.innerText = `Sub-banda ${subbandKey.toUpperCase()} - Vecindad 7×7`;

      const sourceCanvas = document.getElementById(`canvas-dwt-${subbandKey}`);
      if (sourceCanvas) {
        modalCanvasTrans.width = sourceCanvas.width;
        modalCanvasTrans.height = sourceCanvas.height;
        modalCtxTrans.drawImage(sourceCanvas, 0, 0);
      }
    } else {
      modalModeBadge.innerText = currentMode.toUpperCase();
      modalTransLabel.innerText = canvasTransTitle.innerText;
      modalTransDim.innerText = `${canvasTransformed.width} × ${canvasTransformed.height}`;
      if (matrixTransTitle) matrixTransTitle.innerText = 'Salida Transformada - Vecindad 7×7';

      modalCanvasTrans.width = canvasTransformed.width;
      modalCanvasTrans.height = canvasTransformed.height;
      modalCtxTrans.drawImage(canvasTransformed, 0, 0);
    }

    updateModalInspector(256, 256);
  }

  function closeZoomModal() {
    zoomModal.classList.add('hidden');
  }

  canvasOriginal.addEventListener('click', () => openZoomModal());
  canvasTransformed.addEventListener('click', () => openZoomModal());
  document.getElementById('zoom-orig-btn')?.addEventListener('click', () => openZoomModal());
  document.getElementById('zoom-trans-btn')?.addEventListener('click', () => openZoomModal());

  // Listeners para los 4 cuadrantes
  ['ll', 'lh', 'hl', 'hh'].forEach(k => {
    const c = document.getElementById(`canvas-dwt-${k}`);
    if (c) c.addEventListener('click', () => openZoomModal(k));
    const btn = document.querySelector(`[data-quad-zoom="${k}"]`);
    if (btn) btn.addEventListener('click', () => openZoomModal(k));
  });

  closeModalBtn.addEventListener('click', closeZoomModal);
  modalCloseAction.addEventListener('click', closeZoomModal);
  zoomModal.addEventListener('click', (e) => {
    if (e.target === zoomModal) closeZoomModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !zoomModal.classList.contains('hidden')) {
      closeZoomModal();
    }
  });

  function updateModalInspector(origX, origY) {
    if (!activeGrayscale) return;
    origX = Math.min(511, Math.max(0, origX));
    origY = Math.min(511, Math.max(0, origY));

    const origVal = activeGrayscale[origY * 512 + origX];
    modalOrigInspector.innerText = `Coord: (${origX}, ${origY}) | Brillo Entrada: ${origVal}`;
    if (matrixCenterCoord) matrixCenterCoord.innerText = `Píxel Central: (x: ${origX}, y: ${origY})`;

    const tW = modalCanvasTrans.width;
    const tH = modalCanvasTrans.height;
    const tx = Math.floor(origX * (tW / 512));
    const ty = Math.floor(origY * (tH / 512));

    try {
      const p = modalCtxTrans.getImageData(tx, ty, 1, 1).data;
      modalTransInspector.innerText = `Coord: (${tx}, ${ty}) | RGBA: (${p[0]}, ${p[1]}, ${p[2]})`;
    } catch (e) {
      modalTransInspector.innerText = `Coord: (${tx}, ${ty})`;
    }

    // Actualizar las 49 celdas de la vecindad 7x7
    for (let dy = -3; dy <= 3; dy++) {
      for (let dx = -3; dx <= 3; dx++) {
        const cellIdx = (dy + 3) * 7 + (dx + 3);
        const isCenter = (dx === 0 && dy === 0);

        // Matriz Entrada
        const ex = Math.min(511, Math.max(0, origX + dx));
        const ey = Math.min(511, Math.max(0, origY + dy));
        const eVal = activeGrayscale[ey * 512 + ex];
        const cellOrig = origMatrixCells[cellIdx];
        if (cellOrig) {
          cellOrig.textContent = eVal;
          cellOrig.style.backgroundColor = `rgb(${eVal}, ${eVal}, ${eVal})`;
          cellOrig.style.color = eVal > 120 ? '#000000' : '#ffffff';
          cellOrig.style.outline = isCenter ? '2px solid #38bdf8' : 'none';
          cellOrig.style.zIndex = isCenter ? '10' : '1';
        }

        // Matriz Salida
        const sx = Math.min(tW - 1, Math.max(0, tx + dx));
        const sy = Math.min(tH - 1, Math.max(0, ty + dy));
        const pTrans = modalCtxTrans.getImageData(sx, sy, 1, 1).data;
        const lum = Math.round(0.299 * pTrans[0] + 0.587 * pTrans[1] + 0.114 * pTrans[2]);
        const cellTrans = transMatrixCells[cellIdx];
        if (cellTrans) {
          cellTrans.textContent = lum;
          cellTrans.style.backgroundColor = `rgb(${pTrans[0]}, ${pTrans[1]}, ${pTrans[2]})`;
          cellTrans.style.color = lum > 120 ? '#000000' : '#ffffff';
          cellTrans.style.outline = isCenter ? '2px solid #f59e0b' : 'none';
          cellTrans.style.zIndex = isCenter ? '10' : '1';
        }
      }
    }
  }

  modalCanvasOrig.addEventListener('mousemove', (e) => {
    const rect = modalCanvasOrig.getBoundingClientRect();
    const x = Math.floor((e.clientX - rect.left) * (512 / rect.width));
    const y = Math.floor((e.clientY - rect.top) * (512 / rect.height));
    updateModalInspector(x, y);
  });

  modalCanvasTrans.addEventListener('mousemove', (e) => {
    const rect = modalCanvasTrans.getBoundingClientRect();
    const tW = modalCanvasTrans.width;
    const tH = modalCanvasTrans.height;
    const tx = Math.floor((e.clientX - rect.left) * (tW / rect.width));
    const ty = Math.floor((e.clientY - rect.top) * (tH / rect.height));
    const origX = Math.floor(tx * (512 / tW));
    const origY = Math.floor(ty * (512 / tH));
    updateModalInspector(origX, origY);
  });

  // Inicio
  loadPresetImage(presets.stephan);
</script>
