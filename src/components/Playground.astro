---
---

<section id="laboratorio" class="py-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Barra de Control Superior Limpia (Sin ruido, sin paleta, sin botón de cargar) -->
  <div class="bg-white rounded-xl p-3 sm:p-4 border border-slate-200 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-2 overflow-x-auto">
      <span class="text-xs font-mono font-bold text-slate-500 uppercase tracking-wider mr-1">Imagen JWST:</span>
      <button 
        data-preset="stephan"
        class="preset-btn active px-3.5 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <span>🌌 Stephan Quintet</span>
      </button>
      <button 
        data-preset="cliffs"
        class="preset-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <span>⛰️ Cosmic Cliffs</span>
      </button>
      <button 
        data-preset="cartwheel"
        class="preset-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 transition flex items-center gap-1.5 whitespace-nowrap"
      >
        <span>🎡 Cartwheel Galaxy</span>
      </button>
    </div>

    <!-- Indicador de telescopio -->
    <div class="text-[11px] font-mono text-slate-500 hidden md:block">
      Datos Infrarrojos: NASA / ESA / CSA (James Webb Space Telescope)
    </div>
  </div>

  <!-- Pestañas de Transformadas Principales -->
  <div class="flex flex-wrap items-center justify-between gap-2 mb-6">
    <div class="flex flex-wrap gap-2">
      <button data-mode="sobel" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        1. Sobel Espacial
      </button>
      <button data-mode="fft" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        2. Fourier 2D (FFT)
      </button>
      <button data-mode="ift" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        3. IFT & Gibbs (Anillos)
      </button>
      <button data-mode="wavelet" class="mode-tab px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-slate-200 bg-white text-slate-700 hover:bg-slate-50">
        4. Wavelet 2D (4 Cuadrantes)
      </button>
      <button data-mode="stars" class="mode-tab active px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition border border-blue-600 bg-blue-600 text-white">
        ✨ 5. Estrellas Aisladas (Wavelet)
      </button>
    </div>

    <!-- Botón Vista 6 Paneles -->
    <button id="toggle-six-panel-btn" class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold transition bg-indigo-50 border border-indigo-200 text-indigo-700 hover:bg-indigo-100 flex items-center gap-1.5 active:scale-95">
      <span>🖼️ Ver Comparativa de 6 Paneles</span>
    </button>
  </div>

  <!-- Vista Principal Dual (Controles + Canvas Grande) -->
  <div id="dual-view-container" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Panel Izquierdo: Controles Específicos y Diagnóstico Rápido -->
    <div class="lg:col-span-4 flex flex-col gap-4">
      <div class="bg-white rounded-xl p-5 border border-slate-200 space-y-4">
        <div class="flex items-center justify-between pb-2 border-b border-slate-100">
          <span class="text-xs font-mono font-bold text-slate-800 uppercase tracking-wider">Ajustes</span>
          <span id="timing-badge" class="text-[10px] font-mono font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200">
            0.0 ms
          </span>
        </div>

        <!-- 1. Controles Sobel -->
        <div id="controls-sobel" class="space-y-4 hidden">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Componente del Gradiente:</label>
            <div class="grid grid-cols-3 gap-1.5 text-xs">
              <button data-sobel-mode="magnitude" class="sobel-dir-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-semibold">|∇I|</button>
              <button data-sobel-mode="gx" class="sobel-dir-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">Gx (Horiz)</button>
              <button data-sobel-mode="gy" class="sobel-dir-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">Gy (Vert)</button>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-1">
              <span>Umbral de Corte:</span>
              <span id="sobel-threshold-val" class="text-blue-600 font-bold">0</span>
            </div>
            <input type="range" id="sobel-threshold" min="0" max="200" value="0" class="w-full accent-blue-600 cursor-pointer" />
          </div>
        </div>

        <!-- 2. Controles FFT -->
        <div id="controls-fft" class="space-y-3 hidden text-xs text-slate-600 leading-relaxed">
          <p>
            Muestra el espectro de potencias centrado. El núcleo blanco central concentra el brillo medio (DC) y las líneas ortogonales corresponden a bordes y transiciones rápidas.
          </p>
        </div>

        <!-- 3. Controles IFT & Gibbs -->
        <div id="controls-ift" class="space-y-4 hidden">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Filtro en Frecuencia:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-filter-type="highpass" class="filter-type-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-semibold">Pasa-Altos</button>
              <button data-filter-type="lowpass" class="filter-type-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100">Pasa-Bajos</button>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-1">
              <span>Radio de Corte (D0):</span>
              <span id="ift-cutoff-val" class="text-blue-600 font-mono font-bold">25 px</span>
            </div>
            <input type="range" id="ift-cutoff" min="5" max="100" value="25" class="w-full accent-blue-600 cursor-pointer" />
          </div>
          <p class="text-[11px] text-amber-900 bg-amber-50 p-2.5 rounded-lg border border-amber-200 leading-relaxed">
            ⚠️ <strong>Anillos de Gibbs:</strong> Observa las ondas circulares falsas alrededor de las estrellas al recortar frecuencias con una compuerta ideal.
          </p>
        </div>

        <!-- 4. Controles Wavelet Cuadrantes -->
        <div id="controls-wavelet" class="space-y-4 hidden">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Base Wavelet Madre:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-wavelet-mother="haar" class="wavelet-mother-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-mono font-semibold">Haar (db1)</button>
              <button data-wavelet-mother="db4" class="wavelet-mother-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 font-mono hover:bg-slate-100">Daubechies 4 (db4)</button>
            </div>
          </div>
          <p class="text-xs text-slate-600">
            Descompone la imagen en 4 cuadrantes: <strong>LL</strong> (aproximación suave de gas), <strong>HL</strong> (vertical), <strong>LH</strong> (horizontal) y <strong>HH</strong> (estrellas y diagonales).
          </p>
        </div>

        <!-- 5. Controles Aislamiento Estelar -->
        <div id="controls-stars" class="space-y-4">
          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Base Wavelet Madre:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-wavelet-mother="haar" class="wavelet-mother-btn active py-1.5 rounded-lg bg-blue-50 border border-blue-600 text-blue-700 font-mono font-semibold">Haar (db1)</button>
              <button data-wavelet-mother="db4" class="wavelet-mother-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 font-mono hover:bg-slate-100">Daubechies 4 (db4)</button>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs font-mono font-semibold text-slate-700 mb-1">
              <span>Umbral de Extracción Estelar:</span>
              <span id="star-percentile-val" class="text-amber-700 font-mono font-bold">98.5%</span>
            </div>
            <input type="range" id="star-percentile" min="90" max="99.9" step="0.1" value="98.5" class="w-full accent-amber-600 cursor-pointer" />
          </div>

          <div>
            <label class="block text-xs font-mono font-semibold text-slate-700 mb-1">Método de Umbral:</label>
            <div class="grid grid-cols-2 gap-2 text-xs">
              <button data-shrinkage="hard" class="shrinkage-btn active py-1.5 rounded-lg bg-amber-50 border border-amber-600 text-amber-800 font-mono font-semibold">Hard (Corte Directo)</button>
              <button data-shrinkage="soft" class="shrinkage-btn py-1.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-700 font-mono hover:bg-slate-100">Soft (Donoho)</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Diagnóstico Breve -->
      <div class="bg-white rounded-xl p-4 border border-slate-200">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-[10px] font-mono uppercase text-slate-500 font-bold">Diagnóstico:</span>
          <span id="quick-badge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
            Aislamiento Óptimo
          </span>
        </div>
        <p id="quick-desc" class="text-xs text-slate-600 leading-relaxed">
          El gas suave se anula a cero en HH, aislando únicamente las estrellas puntuales limpias.
        </p>
      </div>
    </div>

    <!-- Panel Derecho: Doble Canvas (Marco Limpio sin sombras extrañas) -->
    <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Canvas 1: Entrada -->
      <div class="bg-white rounded-xl p-4 border border-slate-200 flex flex-col items-center">
        <div class="w-full flex items-center justify-between mb-2.5 px-1">
          <span class="text-xs font-mono font-bold text-slate-800">1. ENTRADA (Original)</span>
          <span id="canvas-orig-dim" class="text-[10px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">512 × 512</span>
        </div>
        <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 flex items-center justify-center">
          <canvas id="canvas-original" width="512" height="512" class="w-full h-full object-contain block"></canvas>
        </div>
        <div class="w-full mt-2 text-[10px] font-mono text-slate-600 bg-slate-50 px-2 py-1 rounded border border-slate-200 text-center" id="pixel-inspector">
          Pasa el cursor sobre la imagen para inspeccionar píxeles
        </div>
      </div>

      <!-- Canvas 2: Salida Transformada -->
      <div class="bg-white rounded-xl p-4 border border-slate-200 flex flex-col items-center">
        <div class="w-full flex items-center justify-between mb-2.5 px-1">
          <span id="canvas-trans-title" class="text-xs font-mono font-bold text-blue-700">2. SALIDA TRANSFORMADA</span>
          <button id="download-btn" class="text-[11px] font-mono font-semibold text-blue-600 hover:text-blue-800 transition">Descargar PNG</button>
        </div>
        <div class="relative w-full aspect-square bg-black rounded-lg overflow-hidden border border-slate-300 flex items-center justify-center">
          <canvas id="canvas-transformed" width="512" height="512" class="w-full h-full object-contain block"></canvas>
        </div>
        <div class="w-full mt-2 text-[10px] font-mono text-slate-600 bg-slate-50 px-2 py-1 rounded border border-slate-200 text-center" id="canvas-trans-sub">
          Wavelet: Haar • Estrellas Aisladas
        </div>
      </div>
    </div>
  </div>

  <!-- Vista Secundaria: Pipeline Completo de 6 Paneles -->
  <div id="six-panel-container" class="mt-8 bg-white rounded-xl p-5 border border-slate-200 hidden">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
      <div>
        <h3 class="text-sm font-bold text-slate-900 font-mono uppercase tracking-wider flex items-center gap-2">
          <span>Pipeline Comparativo Completo (6 Paneles)</span>
          <span class="text-[10px] text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded border border-indigo-200 font-semibold">
            Notebook Python
          </span>
        </h3>
      </div>
      <button id="close-six-panel-btn" class="text-xs font-mono font-semibold text-slate-600 hover:text-slate-900 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-200 transition">
        ✕ Volver a Vista Dual
      </button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <!-- Panel 1: Original -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-slate-700 block mb-1.5">1. Original I(x, y)</span>
        <canvas id="p6-c1" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 2: Sobel -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-rose-700 block mb-1.5">2. Sobel (Inferno)</span>
        <canvas id="p6-c2" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 3: FFT -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-indigo-700 block mb-1.5">3. 2D-FFT (Magma)</span>
        <canvas id="p6-c3" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 4: IFT Gibbs -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-amber-700 block mb-1.5">4. IFT Gibbs (Inferno)</span>
        <canvas id="p6-c4" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 5: DWT Cuadrantes -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
        <span class="text-[11px] font-mono font-bold text-slate-700 block mb-1.5">5. 2D-DWT [LL, HL; LH, HH]</span>
        <canvas id="p6-c5" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
      <!-- Panel 6: Wavelet Hot -->
      <div class="p-2.5 bg-slate-50 rounded-xl border border-amber-300 text-center">
        <span class="text-[11px] font-mono text-amber-800 block mb-1.5 font-bold">6. Wavelet Isolation (Hot)</span>
        <canvas id="p6-c6" width="256" height="256" class="w-full aspect-square rounded-lg object-contain bg-black border border-slate-200"></canvas>
      </div>
    </div>
  </div>
</section>

<script>
  import { applyColormap } from '../scripts/colormaps.js';
  import { 
    applySobel, 
    computeFFT2D, 
    getLogSpectrumImage, 
    applyFrequencyFilterAndIFT, 
    computeDWT2D, 
    getWaveletQuadImage, 
    isolateWaveletStars
  } from '../scripts/transforms-advanced.js';

  let currentRawImage = new Image();
  let baseGrayscale = null;
  let activeGrayscale = null;
  let currentMode = 'stars';
  let motherWavelet = 'haar';
  let shrinkageMode = 'hard';

  // Parámetros
  let sobelMode = 'magnitude';
  let sobelThreshold = 0;
  let iftCutoff = 25;
  let iftType = 'highpass';
  let starPercentile = 98.5;

  let cachedFFT = null;
  let cachedDWT = null;

  const canvasOriginal = document.getElementById('canvas-original');
  const canvasTransformed = document.getElementById('canvas-transformed');
  const ctxOriginal = canvasOriginal.getContext('2d');
  const ctxTransformed = canvasTransformed.getContext('2d');

  const timingBadge = document.getElementById('timing-badge');
  const canvasTransTitle = document.getElementById('canvas-trans-title');
  const canvasTransSub = document.getElementById('canvas-trans-sub');
  const quickBadge = document.getElementById('quick-badge');
  const quickDesc = document.getElementById('quick-desc');
  const pixelInspector = document.getElementById('pixel-inspector');

  const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
  const presets = {
    stephan: `${baseUrl}images/stephan_quintet.jpg`,
    cliffs: `${baseUrl}images/cosmic_cliffs.jpg`,
    cartwheel: `${baseUrl}images/cartwheel_galaxy.jpg`
  };

  const diagnostics = {
    sobel: {
      badge: 'Falla en Gas',
      color: 'bg-rose-50 text-rose-800 border-rose-200',
      desc: 'Sobel detecta bordes pero el gas suave continuo genera un gradiente 4 veces mayor que las estrellas, ocultándolas.'
    },
    fft: {
      badge: 'Sin Localización Espacial',
      color: 'bg-rose-50 text-rose-800 border-rose-200',
      desc: 'Fourier muestra las frecuencias globales de la imagen pero pierde la posición (x, y) de las estrellas.'
    },
    ift: {
      badge: 'Anillos Falsos de Gibbs',
      color: 'bg-amber-50 text-amber-800 border-amber-200',
      desc: 'El corte de frecuencias produce ondas oscilatorias concéntricas falsas (+8.95%) alrededor de cada estrella.'
    },
    wavelet: {
      badge: 'Éxito Multirresolución',
      color: 'bg-emerald-50 text-emerald-800 border-emerald-200',
      desc: 'Separa la imagen en 4 sub-bandas: LL (gas suave), LH/HL (bordes direccionales) y HH (estrellas y diagonales).'
    },
    stars: {
      badge: 'Aislamiento Estelar Óptimo',
      color: 'bg-emerald-50 text-emerald-800 border-emerald-200',
      desc: 'El gas suave se anula a cero en HH, aislando únicamente las estrellas puntuales limpias.'
    }
  };

  function loadPresetImage(url) {
    currentRawImage = new Image();
    currentRawImage.crossOrigin = 'anonymous';
    currentRawImage.src = url;
    currentRawImage.onload = () => {
      canvasOriginal.width = 512;
      canvasOriginal.height = 512;
      ctxOriginal.drawImage(currentRawImage, 0, 0, 512, 512);

      const imgData = ctxOriginal.getImageData(0, 0, 512, 512);
      const data = imgData.data;
      baseGrayscale = new Uint8ClampedArray(512 * 512);

      for (let i = 0; i < 512 * 512; i++) {
        baseGrayscale[i] = Math.round(0.299 * data[i * 4] + 0.587 * data[i * 4 + 1] + 0.114 * data[i * 4 + 2]);
      }

      activeGrayscale = baseGrayscale;
      cachedFFT = null;
      cachedDWT = null;
      renderCurrentPipeline();
    };
  }

  function renderOutput(uint8Grayscale, width, height, colormap) {
    canvasTransformed.width = width;
    canvasTransformed.height = height;
    const rgba = applyColormap(uint8Grayscale, width, height, colormap);
    const imgData = new ImageData(rgba, width, height);
    ctxTransformed.putImageData(imgData, 0, 0);
  }

  function renderCurrentPipeline() {
    if (!activeGrayscale) return;
    const t0 = performance.now();

    if (currentMode === 'sobel') {
      canvasTransTitle.innerText = `Sobel Espacial (${sobelMode.toUpperCase()})`;
      const result = applySobel(activeGrayscale, 512, 512, {
        mode: sobelMode,
        threshold: sobelThreshold
      });
      renderOutput(result, 512, 512, 'inferno');
      canvasTransSub.innerText = 'Operador Sobel 3x3 • Paleta: INFERNO';
    }
    else if (currentMode === 'fft') {
      canvasTransTitle.innerText = 'Espectro de Potencias Fourier 2D';
      if (!cachedFFT) {
        cachedFFT = computeFFT2D(activeGrayscale, 512);
      }
      const logSpec = getLogSpectrumImage(cachedFFT.shiftReal, cachedFFT.shiftImag, 512);
      renderOutput(logSpec, 512, 512, 'magma');
      canvasTransSub.innerText = 'FFT Cooley-Tukey Centrada • Paleta: MAGMA';
    }
    else if (currentMode === 'ift') {
      canvasTransTitle.innerText = `Reconstrucción IFT (${iftType.toUpperCase()}, D0=${iftCutoff}px)`;
      if (!cachedFFT) {
        cachedFFT = computeFFT2D(activeGrayscale, 512);
      }
      const recon = applyFrequencyFilterAndIFT(cachedFFT.shiftReal, cachedFFT.shiftImag, 512, iftCutoff, iftType);
      renderOutput(recon, 512, 512, 'inferno');
      canvasTransSub.innerText = 'Fenómeno de Gibbs (Sobreimpulso 8.95%) • Paleta: INFERNO';
    }
    else if (currentMode === 'wavelet') {
      canvasTransTitle.innerText = `Wavelet 2D (${motherWavelet.toUpperCase()}) [LL, HL; LH, HH]`;
      if (!cachedDWT || cachedDWT.mother !== motherWavelet) {
        cachedDWT = computeDWT2D(activeGrayscale, 512, 512, motherWavelet);
      }
      const quad = getWaveletQuadImage(cachedDWT);
      renderOutput(quad, 512, 512, 'grayscale');
      canvasTransSub.innerText = `Sub-bandas Ortogonales • Wavelet: ${motherWavelet.toUpperCase()}`;
    }
    else if (currentMode === 'stars') {
      canvasTransTitle.innerText = `Aislamiento Estelar Óptimo (${motherWavelet.toUpperCase()} - ${starPercentile}%)`;
      if (!cachedDWT || cachedDWT.mother !== motherWavelet) {
        cachedDWT = computeDWT2D(activeGrayscale, 512, 512, motherWavelet);
      }
      const { output, halfW, halfH } = isolateWaveletStars(cachedDWT, starPercentile, shrinkageMode);
      renderOutput(output, halfW, halfH, 'hot');
      canvasTransSub.innerText = 'Sub-banda HH + Umbralizado • Paleta: HOT (Fuego)';
    }

    const t1 = performance.now();
    timingBadge.innerText = `${(t1 - t0).toFixed(1)} ms`;

    const diag = diagnostics[currentMode];
    quickBadge.className = `px-2 py-0.5 rounded text-[10px] font-bold border ${diag.color}`;
    quickBadge.innerText = diag.badge;
    quickDesc.innerText = diag.desc;
  }

  // Renderizar los 6 paneles en paralelo estilo Jupyter Notebook
  function renderSixPanels() {
    if (!activeGrayscale) return;

    function drawTo(canvasId, grayscaleData, width, height, colormap) {
      const c = document.getElementById(canvasId);
      c.width = width;
      c.height = height;
      const ctx = c.getContext('2d');
      const rgba = applyColormap(grayscaleData, width, height, colormap);
      const idata = new ImageData(rgba, width, height);
      ctx.putImageData(idata, 0, 0);
    }

    drawTo('p6-c1', activeGrayscale, 512, 512, 'grayscale');
    const sobelRes = applySobel(activeGrayscale, 512, 512, { mode: 'magnitude', threshold: 0 });
    drawTo('p6-c2', sobelRes, 512, 512, 'inferno');
    if (!cachedFFT) cachedFFT = computeFFT2D(activeGrayscale, 512);
    const spec = getLogSpectrumImage(cachedFFT.shiftReal, cachedFFT.shiftImag, 512);
    drawTo('p6-c3', spec, 512, 512, 'magma');
    const recon = applyFrequencyFilterAndIFT(cachedFFT.shiftReal, cachedFFT.shiftImag, 512, 25, 'highpass');
    drawTo('p6-c4', recon, 512, 512, 'inferno');
    if (!cachedDWT) cachedDWT = computeDWT2D(activeGrayscale, 512, 512, 'haar');
    const quad = getWaveletQuadImage(cachedDWT);
    drawTo('p6-c5', quad, 512, 512, 'grayscale');
    const { output, halfW, halfH } = isolateWaveletStars(cachedDWT, 98.5, 'hard');
    drawTo('p6-c6', output, halfW, halfH, 'hot');
  }

  // Listeners Presets
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.preset-btn').forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'font-bold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'font-bold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      const preset = btn.getAttribute('data-preset');
      loadPresetImage(presets[preset]);
    });
  });

  // Mode Tabs
  document.querySelectorAll('.mode-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.mode-tab').forEach(t => {
        t.classList.remove('border-blue-600', 'bg-blue-600', 'text-white');
        t.classList.add('border-slate-200', 'bg-white', 'text-slate-700');
      });
      tab.classList.add('border-blue-600', 'bg-blue-600', 'text-white');
      tab.classList.remove('border-slate-200', 'bg-white', 'text-slate-700');

      currentMode = tab.getAttribute('data-mode');

      ['sobel', 'fft', 'ift', 'wavelet', 'stars'].forEach(m => {
        const el = document.getElementById(`controls-${m}`);
        if (el) el.classList.add('hidden');
      });
      const active = document.getElementById(`controls-${currentMode}`);
      if (active) active.classList.remove('hidden');

      renderCurrentPipeline();
    });
  });

  // Mother Wavelet Toggle
  document.querySelectorAll('.wavelet-mother-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.wavelet-mother-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      motherWavelet = btn.getAttribute('data-wavelet-mother');
      cachedDWT = null;
      renderCurrentPipeline();
    });
  });

  // Shrinkage Mode
  document.querySelectorAll('.shrinkage-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.shrinkage-btn').forEach(b => {
        b.classList.remove('bg-amber-50', 'border-amber-600', 'text-amber-800', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-amber-50', 'border-amber-600', 'text-amber-800', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      shrinkageMode = btn.getAttribute('data-shrinkage');
      renderCurrentPipeline();
    });
  });

  // Sobel Direction
  document.querySelectorAll('.sobel-dir-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.sobel-dir-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      sobelMode = btn.getAttribute('data-sobel-mode');
      renderCurrentPipeline();
    });
  });

  document.getElementById('sobel-threshold').addEventListener('input', (e) => {
    sobelThreshold = parseInt(e.target.value);
    document.getElementById('sobel-threshold-val').innerText = sobelThreshold;
    renderCurrentPipeline();
  });

  // IFT Filter Type
  document.querySelectorAll('.filter-type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-type-btn').forEach(b => {
        b.classList.remove('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
        b.classList.add('bg-slate-50', 'border-slate-200', 'text-slate-700');
      });
      btn.classList.add('bg-blue-50', 'border-blue-600', 'text-blue-700', 'font-semibold');
      btn.classList.remove('bg-slate-50', 'border-slate-200', 'text-slate-700');

      iftType = btn.getAttribute('data-filter-type');
      renderCurrentPipeline();
    });
  });

  document.getElementById('ift-cutoff').addEventListener('input', (e) => {
    iftCutoff = parseInt(e.target.value);
    document.getElementById('ift-cutoff-val').innerText = `${iftCutoff} px`;
    renderCurrentPipeline();
  });

  // Star Percentile
  document.getElementById('star-percentile').addEventListener('input', (e) => {
    starPercentile = parseFloat(e.target.value);
    document.getElementById('star-percentile-val').innerText = `${starPercentile.toFixed(1)}%`;
    renderCurrentPipeline();
  });

  // Pixel Inspector
  canvasOriginal.addEventListener('mousemove', (e) => {
    if (!activeGrayscale) return;
    const rect = canvasOriginal.getBoundingClientRect();
    const x = Math.floor((e.clientX - rect.left) * (512 / rect.width));
    const y = Math.floor((e.clientY - rect.top) * (512 / rect.height));
    if (x >= 0 && x < 512 && y >= 0 && y < 512) {
      const val = activeGrayscale[y * 512 + x];
      pixelInspector.innerText = `Coordenada: (${x}, ${y}) | Brillo: ${val}`;
    }
  });

  // Toggle 6-panel view
  const sixPanelContainer = document.getElementById('six-panel-container');
  const dualViewContainer = document.getElementById('dual-view-container');
  const toggleSixBtn = document.getElementById('toggle-six-panel-btn');
  const closeSixBtn = document.getElementById('close-six-panel-btn');

  toggleSixBtn.addEventListener('click', () => {
    sixPanelContainer.classList.remove('hidden');
    dualViewContainer.classList.add('hidden');
    renderSixPanels();
  });

  closeSixBtn.addEventListener('click', () => {
    sixPanelContainer.classList.add('hidden');
    dualViewContainer.classList.remove('hidden');
  });

  // Download
  document.getElementById('download-btn').addEventListener('click', () => {
    const link = document.createElement('a');
    link.download = `jwst_${currentMode}.png`;
    link.href = canvasTransformed.toDataURL('image/png');
    link.click();
  });

  // Inicio
  loadPresetImage(presets.stephan);
</script>
