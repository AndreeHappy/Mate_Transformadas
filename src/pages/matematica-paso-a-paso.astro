---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

// Fórmulas matemáticas alineadas 1:1 con la exposición del caso práctico Stephan's Quintet (JWST)
const formulas = {
  // Pestaña 1: Fourier 2D y Euler
  fourierFunction: String.raw`$$\hat{I}(u, v) = \sum_{x=0}^{M-1} \sum_{y=0}^{N-1} I(x, y) e^{-j 2\pi \left( \frac{ux}{M} + \frac{vy}{N} \right)}$$`,
  eulerIdentity: String.raw`$$e^{-j\theta} = \cos(\theta) - j\sin(\theta)$$`,
  fourierExpanded: String.raw`$$\hat{I}(u, v) = \sum_{x} \sum_{y} I(x, y) \cos(\theta) - j \sum_{x} \sum_{y} I(x, y) \sin(\theta)$$`,
  patch2x2: String.raw`$$I_{2 \times 2} = \begin{bmatrix} I(0, 0)=35 & I(0, 1)=\mathbf{240} \\ I(1, 0)=38 & I(1, 1)=45 \end{bmatrix}, \quad M = 2, \ N = 2$$`,
  angleFormula: String.raw`$$\theta(x, y) = 2\pi \left( \frac{ux}{2} + \frac{vy}{2} \right) = \pi (ux + vy)$$`,
  dcResult: String.raw`$$\text{Re}\{\hat{I}(0, 0)\} = (35 \times 1) + (240 \times 1) + (38 \times 1) + (45 \times 1) = 35 + 240 + 38 + 45 = \mathbf{358}$$`,
  horizResult: String.raw`$$\text{Re}\{\hat{I}(0, 1)\} = (35 \times \mathbf{+1}) + (240 \times \mathbf{-1}) + (38 \times \mathbf{+1}) + (45 \times \mathbf{-1}) = +35 - 240 + 38 - 45 = \mathbf{-212}$$`,

  // Pestaña 2: Inversa y Gibbs
  iftFormula: String.raw`$$f(x, y) = \mathcal{F}^{-1}\{\hat{I}(u, v) \cdot H(u, v)\}$$`,
  dirichletTaylor: String.raw`$$\text{Si}(\pi) = \int_0^\pi \frac{\sin(t)}{t} dt = \pi - \frac{\pi^3}{18} + \frac{\pi^5}{600} - \frac{\pi^7}{35280} \dots \approx \mathbf{1.851937}$$`,
  gibbsRatio: String.raw`$$\frac{\text{Si}(\pi)}{\pi} = \frac{1.851937}{3.14159265} \approx \mathbf{0.589489} \implies 0.589489 - 0.500000 = \mathbf{0.089489 \ (8.95\%)}$$`,
  gibbsRecon: String.raw`$$I_{\text{pico}} = 200 + (200 \times 0.0895) = \mathbf{217.9}, \quad I_{\text{valle}} = 0 - 17.9 = \mathbf{-17.9 \to 0}, \quad I_{\text{segundo\_anillo}} = \mathbf{+9.8}$$`,

  // Pestaña 3: Wavelet 2D
  haarFilters: String.raw`$$L = \frac{x_0 + x_1}{\sqrt{2}} \quad (\text{Aproximación}), \qquad H = \frac{x_0 - x_1}{\sqrt{2}} \quad (\text{Detalle})$$`,
  patch4x4: String.raw`$$I_{4 \times 4} = \begin{bmatrix} 30 & 32 & 34 & 36 \\ 32 & 34 & \mathbf{240} & 40 \\ 34 & 36 & 38 & 40 \\ 36 & 38 & 40 & 42 \end{bmatrix}$$`,
  hhEquation: String.raw`$$HH = \frac{H_{\text{fila\_par}} - H_{\text{fila\_impar}}}{\sqrt{2}}$$`,
  hhGasCalc: String.raw`$$HH(0, 0) = \frac{(-1.41) - (-1.41)}{\sqrt{2}} = \frac{-1.41 + 1.41}{1.4142} = \frac{0.00}{1.4142} = \mathbf{0.00}$$`,
  hhStarCalc: String.raw`$$HH(0, 1) = \frac{141.42 - (-1.41)}{\sqrt{2}} = \frac{141.42 + 1.41}{1.4142} = \frac{142.83}{1.4142} = \mathbf{+101.00}$$`,
  subbandHH: String.raw`$$|HH| = \begin{bmatrix} \mathbf{0.00} & \mathbf{101.00} \\ \mathbf{0.00} & \mathbf{0.00} \end{bmatrix}$$`,
  gpuComparison: String.raw`$$\text{Convolución Espacial Directa: } \mathbf{39.30\text{ GB}} \implies \text{Con Wavelet 2D } (\downarrow 2): \mathbf{9.82\text{ GB}} \ (75\% \text{ de ahorro})$$`
};

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Layout title="Pizarra Matemática: Caso Práctico Stephan's Quintet">
  <Header />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Encabezado de la Pizarra de Exposición -->
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-5">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-2">
          <span>Caso de Estudio: Stephan's Quintet (Telescopio James Webb - 153.5 MP)</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Pizarra de Exposición: Cálculo Aritmético Paso a Paso
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-3xl leading-relaxed">
          Estructura matemática exacta correspondiente a tus diapositivas de defensa: Fourier 2D, Inversa con Fenómeno de Gibbs y Transformada Wavelet 2D.
        </p>
      </div>

      <a href={base} class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 transition active:scale-95 shadow-xs">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        <span>Volver al Laboratorio</span>
      </a>
    </div>

    <!-- Menú de 3 Pestañas de Exposición (1:1 con tus Diapositivas) -->
    <div class="flex flex-wrap gap-2 mb-8 bg-white p-2 rounded-2xl border border-slate-200 shadow-xs">
      <button data-tab="tab-fourier" class="calc-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition bg-blue-600 text-white">
        1. Fourier 2D y Euler (Diapos 1 y 2)
      </button>
      <button data-tab="tab-gibbs" class="calc-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition bg-white text-slate-700 hover:bg-slate-50 border border-transparent">
        2. Inversa y Gibbs 8.95% (Diapos 3 y 4)
      </button>
      <button data-tab="tab-wavelet" class="calc-tab px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold transition bg-white text-slate-700 hover:bg-slate-50 border border-transparent">
        3. Wavelet 2D y Ahorro VRAM (Diapos 5 y 6)
      </button>
    </div>

    <!-- PESTAÑA 1: FOURIER 2D Y EULER (DIAPOSITIVAS 1 Y 2) -->
    <div id="tab-fourier" class="tab-pane space-y-6">
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
          <span class="w-8 h-8 rounded-lg bg-blue-50 text-blue-700 text-sm flex items-center justify-center font-mono font-bold border border-blue-200">01</span>
          <div>
            <h2 class="text-xl font-bold text-slate-900">Fourier 2D e Identidad de Euler (Diapositivas 1 y 2)</h2>
            <p class="text-xs text-slate-500 font-mono">Descomposición del Parche 2×2 y Detección de Discontinuidad</p>
          </div>
        </div>

        <!-- 1. Formulación e Identidad de Euler -->
        <div class="space-y-3">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-blue-700">A. La Fórmula y el Traductor de Euler</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center text-xs font-mono space-y-2">
              <span class="text-slate-500 block text-[11px]">Transformada 2D Abstracta:</span>
              {formulas.fourierFunction}
            </div>
            <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center text-xs font-mono space-y-2">
              <span class="text-slate-500 block text-[11px]">Identidad de Euler:</span>
              {formulas.eulerIdentity}
            </div>
          </div>
          <div class="p-3 bg-blue-50/70 border border-blue-200 rounded-xl text-xs text-blue-900 leading-relaxed font-sans">
            <strong>Explicación:</strong> La computadora no calcula números imaginarios abstractos; utiliza la Identidad de Euler para desdoblar la exponencial en dos sumatorias reales: una con cosenos (parte real) y otra con senos (parte imaginaria).
          </div>
        </div>

        <!-- 2. Parche 2x2 y Valores Discretos -->
        <div class="space-y-3 pt-2">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800">B. Parche Cósmico de Stephan's Quintet (NGC 7319)</h3>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center text-sm font-mono">
            {formulas.patch2x2}
          </div>
          <div class="p-3 bg-slate-100 rounded-xl border border-slate-200 text-xs font-mono text-slate-800 space-y-1">
            <div>{formulas.angleFormula}</div>
            <div class="text-slate-600 font-sans">
              Como las coordenadas son discretas (x, y en {0, 1}), los ángulos resultan múltiplos enteros de pi:
            </div>
            <div class="font-bold text-slate-900 pt-1">
              • Para theta = 0 &rarr; cos(0) = +1, sin(0) = 0 &nbsp;|&nbsp; • Para theta = pi &rarr; cos(pi) = -1, sin(pi) = 0
            </div>
          </div>
        </div>

        <!-- 3. Cálculo Aritmético Término a Término -->
        <div class="space-y-4 pt-2">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800">C. Cálculo Aritmético Resuelto a Mano (Suma por Suma)</h3>

          <!-- Coeficiente DC -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2 text-xs font-mono">
            <div class="flex items-center justify-between">
              <span class="text-blue-700 font-bold text-sm">1. Componente DC (u = 0, v = 0) &rarr; Energía Lumínica Total</span>
              <span class="text-xs font-bold bg-blue-100 text-blue-800 px-2 py-0.5 rounded">Resultado = 358 + 0j</span>
            </div>
            <div class="text-slate-600 font-sans text-xs">
              theta = pi(0) = 0 &rarr; cos(0) = 1, sin(0) = 0. Todos los senos se anulan y sumamos los 4 píxeles:
            </div>
            <div class="p-2.5 bg-white rounded border border-slate-200 text-center text-xs">
              {formulas.dcResult}
            </div>
            <div class="text-[11px] font-sans text-slate-500">
              Significado físico: Energía total acumulada en el parche. El brillo medio por píxel es 358 / 4 = 89.5.
            </div>
          </div>

          <!-- Coeficiente Horizontal -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2 text-xs font-mono">
            <div class="flex items-center justify-between">
              <span class="text-blue-700 font-bold text-sm">2. Componente Horizontal (u = 0, v = 1) &rarr; Detección de Discontinuidad</span>
              <span class="text-xs font-bold bg-rose-100 text-rose-800 px-2 py-0.5 rounded">Resultado = -212 + 0j</span>
            </div>
            <div class="text-slate-600 font-sans text-xs">
              theta(x, y) = pi*y &rarr; Columna izquierda (y=0) tiene cos(0)=+1; Columna derecha (y=1) tiene cos(pi)=-1:
            </div>
            <div class="p-2.5 bg-white rounded border border-slate-200 text-center text-xs">
              {formulas.horizResult}
            </div>
            <div class="text-[11px] font-sans text-slate-500">
              Magnitud |I(0, 1)| = 212. La resta entre la columna izquierda y derecha produce -212 por la presencia de la estrella brillante (240).
            </div>
          </div>

          <!-- Conclusión de Ceguera Espacial -->
          <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl space-y-1.5 text-xs text-rose-900 leading-relaxed font-sans">
            <span class="font-bold block">La Falla Crítica de Fourier demostrada ante el Jurado:</span>
            <p>
              El coeficiente -212 confirma una violenta variación horizontal. Sin embargo, el resultado es un único escalar global. Al integrar sobre toda la imagen, <strong>Fourier ha destruido las coordenadas espaciales (x, y)</strong>: no puede decirnos en qué píxel o en qué galaxia se encuentra la estrella.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- PESTAÑA 2: INVERSA Y GIBBS (DIAPOSITIVAS 3 Y 4) -->
    <div id="tab-gibbs" class="tab-pane space-y-6 hidden">
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
          <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-700 text-sm flex items-center justify-center font-mono font-bold border border-amber-200">02</span>
          <div>
            <h2 class="text-xl font-bold text-slate-900">Inversa de Fourier y Fenómeno de Gibbs (Diapositivas 3 y 4)</h2>
            <p class="text-xs text-slate-500 font-mono">Deducción Analítica del Sobreimpulso del 8.95% y Efecto en Redes Neuronales</p>
          </div>
        </div>

        <!-- 1. Truncamiento en Frecuencia -->
        <div class="space-y-3">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-amber-700">A. La Reconstrucción Inversa tras el Filtrado</h3>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center text-xs font-mono">
            {formulas.iftFormula}
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Al recortar frecuencias con una compuerta ideal de radio D0, en el espacio se produce una convolución con la función seno cardinal sin(t)/t. La onda oscilatoria rebota al intentar reconstruir el salto vertical de la estrella.
          </p>
        </div>

        <!-- 2. Demostración Matemática del 8.95% -->
        <div class="space-y-3 pt-2">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800">B. Demostración Matemática: Integral del Seno de Dirichlet</h3>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center text-xs font-mono overflow-x-auto">
            {formulas.dirichletTaylor}
          </div>
          <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-center text-xs font-mono font-bold text-amber-950">
            {formulas.gibbsRatio}
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            El valor <strong>8.95%</strong> es una constante matemática universal: la onda siempre sobrepasará el escalón físico en un 8.95% sin importar el radio de corte.
          </p>
        </div>

        <!-- 3. Valores Reales y Peligro en CNNs -->
        <div class="space-y-4 pt-2">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800">C. Reconstrucción sobre la Estrella de Stephan's Quintet (Salto de 200)</h3>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center text-xs sm:text-sm font-mono">
            {formulas.gibbsRecon}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs font-mono text-center">
            <div class="p-3 bg-amber-50 rounded-xl border border-amber-200">
              <span class="text-amber-800 font-bold block text-sm">+217.9 (Pico Falso)</span>
              Sobreimpulso que excede el valor real medido por el sensor físico del telescopio.
            </div>
            <div class="p-3 bg-slate-100 rounded-xl border border-slate-200">
              <span class="text-slate-700 font-bold block text-sm">-17.9 &rarr; 0 (Valle)</span>
              Subimpulso negativo que el sensor trunca a cero, formando un halo negro artificial.
            </div>
            <div class="p-3 bg-amber-50 rounded-xl border border-amber-200">
              <span class="text-amber-800 font-bold block text-sm">+9.8 (Segundo Anillo)</span>
              Onda concéntrica brillante secundaria visible alrededor de la estrella.
            </div>
          </div>

          <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl space-y-1.5 text-xs text-rose-900 leading-relaxed font-sans">
            <span class="font-bold block">El Peligro para Redes Neuronales Convolucionales (CNNs):</span>
            <p>
              Una CNN entrenada en astronomía detecta estos anillos oscilatorios de brillo +9.8 y los clasifica erróneamente como <strong>discos de gas protoplanetarios o lentes gravitacionales inexistentes</strong>. Fourier genera artefactos inadmisibles para la visión por computadora.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- PESTAÑA 3: WAVELET 2D Y AHORRO VRAM (DIAPOSITIVAS 5 Y 6) -->
    <div id="tab-wavelet" class="tab-pane space-y-6 hidden">
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200 space-y-6">
        <div class="flex items-center gap-3 pb-4 border-b border-slate-100">
          <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 text-sm flex items-center justify-center font-mono font-bold border border-emerald-200">03</span>
          <div>
            <h2 class="text-xl font-bold text-slate-900">Wavelet 2D y la Solución Ganadora (Diapositivas 5 y 6)</h2>
            <p class="text-xs text-slate-500 font-mono">Anulación del Gas a 0.00, Aislamiento Estelar +101.00 y Ahorro del 75% en VRAM</p>
          </div>
        </div>

        <!-- 1. Filtros de Haar y Parche 4x4 -->
        <div class="space-y-3">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-700">A. Filtros Ortogonales de Haar y Parche Cósmico 4×4</h3>
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-center text-xs font-mono">
            {formulas.haarFilters}
          </div>
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center text-sm font-mono">
            {formulas.patch4x4}
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            El gas de fondo crece suavemente de 30 a 42 (baja frecuencia). En la fila 1, columna 2, la estrella inyecta un pulso agudo de 240 (alta frecuencia).
          </p>
        </div>

        <!-- 2. Cálculo en la Pizarra de las Dos Etapas -->
        <div class="space-y-4 pt-2">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800">B. Descomposición Separable de Mallat: Fila por Fila y Columna por Columna</h3>

          <!-- Etapa 1: Filas -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2 text-xs font-mono">
            <span class="text-blue-700 font-bold block text-sm">Etapa 1: Filtrado Horizontal sobre las Filas H = (x0 - x1) / &radic;2</span>
            <div class="space-y-1 text-slate-700">
              <div>• Fila 0 (Gas): (30 - 32)/1.4142 = <strong class="text-slate-900">-1.41</strong> &nbsp;|&nbsp; (34 - 36)/1.4142 = <strong class="text-slate-900">-1.41</strong></div>
              <div class="bg-amber-50 p-1.5 rounded border border-amber-200 text-amber-900">
                • Fila 1 (Estrella): (32 - 34)/1.4142 = -1.41 &nbsp;|&nbsp; (240 - 40)/1.4142 = 200/1.4142 = <strong class="text-amber-800 font-bold">+141.42 (¡Pico de Detalle!)</strong>
              </div>
              <div>• Filas 2 y 3 (Gas): Todos los pares de detalle dan idénticamente <strong class="text-slate-900">-1.41</strong>.</div>
            </div>
          </div>

          <!-- Etapa 2: Columnas y Sub-banda HH -->
          <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-3 text-xs font-mono">
            <span class="text-blue-700 font-bold block text-sm">Etapa 2: Filtrado Vertical de Columnas para Formar la Sub-banda HH</span>
            <div class="p-2 bg-white rounded border border-slate-200 text-center">
              {formulas.hhEquation}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-1">
              <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-200 space-y-1">
                <span class="font-bold text-emerald-900 block">1. Cuadrante Gas vs Gas (0, 0):</span>
                <div>{formulas.hhGasCalc}</div>
                <span class="text-emerald-800 font-bold font-sans">¡El gas continuo se anula exactamente a CERO ABSOLUTO!</span>
              </div>
              <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 space-y-1">
                <span class="font-bold text-amber-900 block">2. Cuadrante Gas vs Estrella (0, 1):</span>
                <div>{formulas.hhStarCalc}</div>
                <span class="text-amber-800 font-bold font-sans">¡La estrella queda aislada limpia con valor +101.00!</span>
              </div>
            </div>

            <div class="p-3 bg-white rounded-xl border border-slate-200 text-center text-sm">
              {formulas.subbandHH}
            </div>
          </div>

          <!-- 3. Métricas de Hardware en GPU -->
          <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-xl space-y-2 text-xs">
            <span class="font-bold text-emerald-950 block text-sm font-sans">
              C. Impacto Cuantitativo en Hardware GPU sobre Stephan's Quintet (153.5 MP):
            </span>
            <div class="p-3 bg-white rounded-lg border border-emerald-200 text-center font-mono text-xs sm:text-sm font-bold text-emerald-900">
              {formulas.gpuComparison}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-1 font-sans text-emerald-900">
              <div class="p-2 bg-emerald-100/60 rounded">
                <strong>1. Sin Anillos Falsos:</strong> Soporte compacto libre del sobreimpulso de Gibbs.
              </div>
              <div class="p-2 bg-emerald-100/60 rounded">
                <strong>2. Ubicación Espacial:</strong> Sabemos exactamente que la estrella está en el cuadrante (0, 1).
              </div>
              <div class="p-2 bg-emerald-100/60 rounded">
                <strong>3. Viable en GPU:</strong> 9.82 GB cabe en GPUs comunes sin colapsar la memoria VRAM.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  const tabs = document.querySelectorAll('.calc-tab');
  const panes = document.querySelectorAll('.tab-pane');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('bg-blue-600', 'text-white');
        t.classList.add('bg-white', 'text-slate-700');
      });
      tab.classList.add('bg-blue-600', 'text-white');
      tab.classList.remove('bg-white', 'text-slate-700');

      const targetId = tab.getAttribute('data-tab');
      panes.forEach(p => p.classList.add('hidden'));
      const activePane = document.getElementById(targetId);
      if (activePane) activePane.classList.remove('hidden');
    });
  });
</script>
